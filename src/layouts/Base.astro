---
import '@fontsource/titillium-web/400.css';
import '@fontsource/titillium-web/600.css';
import '@fontsource/rajdhani/500.css';
import '@fontsource/rajdhani/600.css';
import '@fontsource/rajdhani/700.css';
import '../styles/global.css';
// The three faces every first screen uses, preloaded so they arrive with the
// stylesheet instead of after it — otherwise the swap from the fallback
// font reflows the hero (measured CLS ≈ 0.1 on interior pages).
import rajdhani700 from '@fontsource/rajdhani/files/rajdhani-latin-700-normal.woff2?url';
import rajdhani600 from '@fontsource/rajdhani/files/rajdhani-latin-600-normal.woff2?url';
import titillium400 from '@fontsource/titillium-web/files/titillium-web-latin-400-normal.woff2?url';
import Nav from '../components/Nav.astro';
import BrandMark from '../components/ui/BrandMark.astro';
import NeuralField from '../components/ui/NeuralField.astro';

interface Props {
  title?: string;
  description?: string;
  /** Root-relative path to a page-specific social card (falls back to the brand card). */
  ogImage?: string;
  /** Structured data — one object or an array; rendered as a single JSON-LD block. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Error pages: skip canonical/og:url (a 404 must not canonicalise itself). */
  omitCanonical?: boolean;
  /** Open Graph type — 'article' for news items. */
  ogType?: 'website' | 'article';
  /** ISO calendar day, emitted as article:published_time with ogType 'article'. */
  publishedTime?: string;
  /** Pages that end with their own closing call to action pass false, so
   *  the footer does not repeat it directly underneath. */
  footerCta?: boolean;
}

const {
  title = 'Integrant — Where biology becomes intelligence',
  description = 'Integrant designs and delivers orthopaedic implant systems, biologics and surgical technology across Australia and New Zealand.',
  ogImage: ogImagePath = '/brand/og.png',
  jsonLd,
  omitCanonical = false,
  ogType = 'website',
  publishedTime,
  footerCta = true,
} = Astro.props;

// Analytics (Plausible) renders only when the build carries the site domain —
// production on Vercel. Local and QA builds ship no tag at all. The script is
// served first-party via the /stats/* rewrites in vercel.json, and the
// `plausible` queue stub lets goal events fire before the script has loaded.
const plausibleDomain = (import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN ?? '').trim();

const ogImage = new URL(ogImagePath, Astro.site ?? Astro.url);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

// Site-wide Organization record; pages can append their own JSON-LD via the
// jsonLd prop (e.g. BreadcrumbList + Product on product pages).
const organization = {
  '@type': 'Organization',
  name: 'Integrant',
  url: 'https://integrant.com.au',
  logo: 'https://integrant.com.au/brand/logo-512.png',
  email: 'admin@integrant.com.au',
  legalName: 'Integrant Pty Ltd',
  foundingDate: '2015',
  taxID: 'ABN 73 605 083 485',
  sameAs: ['https://www.linkedin.com/company/integrantau/'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '5 Ward Avenue',
    addressLocality: 'Potts Point',
    addressRegion: 'NSW',
    postalCode: '2011',
    addressCountry: 'AU',
  },
};
const jsonLdBlocks = [organization, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const jsonLdPayload = JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLdBlocks });
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Dark-first: the chrome colour matches the default dark base; the
         inline script / toggle update this single meta on explicit choice -->
    <meta name="theme-color" content="#050505" />
    {[rajdhani700, rajdhani600, titillium400].map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/brand/favicon-64.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {!omitCanonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {!omitCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Integrant" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={jsonLdPayload} />
    {
      plausibleDomain && (
        <>
          <script is:inline defer data-domain={plausibleDomain} data-api="/stats/api/event" src="/stats/js/script.js" />
          <script is:inline set:html={`window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)}`} />
        </>
      )
    }
    <script is:inline>
      // Theme resolution runs FIRST and synchronously — this is the only
      // thing standing between the visitor and a flash of the wrong theme.
      // Dark-first: every visitor gets the dark experience unless they have
      // explicitly chosen light via the toggle. The OS scheme is ignored.
      (function () {
        var d = document.documentElement;
        var stored = null;
        try {
          stored = localStorage.getItem('integrant-theme');
        } catch (e) {
          /* private mode / storage disabled — dark it is */
        }
        var theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
        d.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.content = theme === 'light' ? '#ffffff' : '#050505';
      })();

      // FOUC guard for the hero power-on: hide boot elements only when the
      // motion system will animate them; release after 3s if it never loads.
      (function () {
        var d = document.documentElement;
        var off =
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          new URLSearchParams(location.search).get('motion') === 'off';
        d.dataset.motion = off ? 'off' : 'pending';
        if (off) return;
        // Safety release: show static content if the motion system never
        // arrives. The timer only counts while the page is actually visible
        // (prerendered/background tabs keep the stage dark until revealed).
        var release = function () {
          setTimeout(function () {
            if (d.dataset.motion === 'pending') d.dataset.motion = 'off';
          }, 3000);
        };
        if (document.hidden) {
          document.addEventListener('visibilitychange', function onVis() {
            if (!document.hidden) {
              document.removeEventListener('visibilitychange', onVis);
              release();
            }
          });
        } else {
          release();
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>

    <footer id="contact" data-contrast class="relative overflow-hidden border-t border-hairline bg-base text-ink">
      <NeuralField variant="edge" seed={271} />
      <span class="corner corner-tr border-hairline-strong" aria-hidden="true"></span>

      <div class:list={['relative mx-auto max-w-6xl px-6', footerCta ? 'pt-28 md:pt-36' : 'pt-4']}>
        <!-- The close: one statement, one action. Skipped on pages that
             already end with their own. -->
        {
          footerCta && (
            <div class="pb-24 text-center" data-print-hide>
              <h2 class="display-1" data-reveal>
                Partner with Integrant.
              </h2>
              <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-2" data-reveal>
                Implants, biologics and clinical intelligence as one system.
                Surgeons, hospitals, distributors and research partners —
                start the conversation.
              </p>
              <div class="mt-10" data-reveal>
                <a href="/contact" class="cta-solid" data-magnetic data-event="Request Meeting" data-event-location="footer">Get in touch</a>
              </div>
            </div>
          )
        }

        <!-- The register: brand anchor + full route map. Contrast band, so
             the scoped ink tokens hold in both site themes. -->
        <div class="grid gap-12 border-t border-hairline pt-14 text-left md:grid-cols-[1.3fr_1fr_1fr_1fr] md:gap-10">
          <div>
            <a href="/" class="tap-target inline-flex items-center gap-3" aria-label="Integrant — home">
              <BrandMark size={30} class="text-ink" />
              <span class="font-display text-[18px] font-semibold uppercase text-ink" style="letter-spacing: var(--tracking-nav);">
                Integrant
              </span>
            </a>
            <p class="mt-6 max-w-[26ch] text-[18px] leading-relaxed text-ink-2">
              Orthopaedic med-tech, bio-tech and AI — one platform, engineered
              in Sydney.
            </p>
            <address class="mt-8 space-y-2 not-italic">
              <p class="readout text-xs leading-relaxed text-ink-2">
                5 Ward Avenue<br />Potts Point NSW 2011
              </p>
              <p class="readout text-xs text-ink-3">33.87°S · 151.22°E</p>
              <a
                href="mailto:admin@integrant.com.au"
                class="readout tap-target-sm text-xs text-ink-2 transition-colors duration-300 hover:text-ink"
                data-event="Email Click"
                data-event-location="footer"
              >
                admin@integrant.com.au
              </a>
              <p>
                <a
                  href="mailto:media@integrant.com.au"
                  class="readout tap-target-sm text-xs text-ink-2 transition-colors duration-300 hover:text-ink"
                  data-event="Email Click"
                  data-event-location="footer-media"
                >
                  media@integrant.com.au
                </a>
              </p>
            </address>
          </div>

          <nav aria-label="Footer" class="contents" data-print-hide>
            {
              [
                {
                  heading: 'Products',
                  links: [
                    { href: '/products', label: 'All systems' },
                    { href: '/products#med-tech', label: 'Med-Tech' },
                    { href: '/products#bio-tech', label: 'Bio-Tech' },
                  ],
                },
                {
                  heading: 'Company',
                  links: [
                    { href: '/about', label: 'About' },
                    { href: '/investors', label: 'Investors' },
                    { href: '/news', label: 'News' },
                    { href: '/partners', label: 'Partners' },
                    { href: '/contact', label: 'Contact' },
                  ],
                },
                {
                  heading: 'Clinical',
                  links: [
                    { href: '/for-surgeons', label: 'For surgeons' },
                    { href: '/innovation', label: 'Innovation' },
                    { href: '/research', label: 'Research' },
                  ],
                },
              ].map((column) => (
                <div>
                  <p class="readout text-ink-2">{column.heading}</p>
                  <ul class="mt-5 space-y-1.5">
                    {column.links.map((link) => (
                      <li>
                        <a href={link.href} class="tap-target-sm text-[18px] text-ink-2 transition-colors duration-300 hover:text-ink">
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </nav>
        </div>

        <!-- Legal row -->
        <div class="mt-16 flex flex-col items-start justify-between gap-6 border-t border-hairline pb-6 pt-8 md:flex-row md:items-center">
          <p class="readout text-xs text-ink-3">© 2026 Integrant Pty Ltd · ABN 73 605 083 485 · Sydney, Australia</p>
          <div class="flex flex-wrap items-center gap-8">
            <a href="https://www.linkedin.com/company/integrantau/" target="_blank" rel="noopener noreferrer" class="readout tap-target-sm text-xs text-ink-2 transition-colors duration-300 hover:text-ink">
              LinkedIn ↗
            </a>
            <a href="/privacy" class="readout tap-target-sm text-xs text-ink-2 transition-colors duration-300 hover:text-ink">
              Privacy
            </a>
            <a href="#main" class="readout tap-target-sm text-xs text-ink-2 transition-colors duration-300 hover:text-ink">
              Top ↑
            </a>
          </div>
        </div>
      </div>

      <!-- The signature: the wordmark as architecture, bleeding off the page.
           Decorative; clipped by the footer's overflow-hidden. -->
      <p
        class="pointer-events-none relative -mb-[0.23em] select-none whitespace-nowrap text-center font-display font-bold leading-none text-ink/[0.06]"
        style="font-size: clamp(90px, 16.5vw, 250px); letter-spacing: 0.02em;"
        aria-hidden="true"
      >
        INTEGRANT
      </p>
    </footer>

    <div class="grain" aria-hidden="true"></div>

    <script>
      import { initMotion } from '../scripts/motion';
      import { initAnalytics } from '../scripts/analytics';
      initAnalytics();
      initMotion();
    </script>
  </body>
</html>
