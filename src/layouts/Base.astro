---
import '@fontsource/titillium-web/400.css';
import '@fontsource/titillium-web/600.css';
import '@fontsource/rajdhani/500.css';
import '@fontsource/rajdhani/600.css';
import '@fontsource/rajdhani/700.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Integrant — Engineering the future of orthopaedic care',
  description = 'Integrant designs and delivers orthopaedic implant systems, biologics and surgical technology across Australia and New Zealand.',
} = Astro.props;

const ogImage = new URL('/brand/og.png', Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Prototype preview: remove before production launch -->
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" sizes="64x64" href="/brand/favicon-64.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // FOUC guard for the hero power-on: hide boot elements only when the
      // motion system will animate them; release after 3s if it never loads.
      (function () {
        var d = document.documentElement;
        var off =
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          new URLSearchParams(location.search).get('motion') === 'off';
        d.dataset.motion = off ? 'off' : 'pending';
        if (off) return;
        // Safety release: show static content if the motion system never
        // arrives. The timer only counts while the page is actually visible
        // (prerendered/background tabs keep the stage dark until revealed).
        var release = function () {
          setTimeout(function () {
            if (d.dataset.motion === 'pending') d.dataset.motion = 'off';
          }, 3000);
        };
        if (document.hidden) {
          document.addEventListener('visibilitychange', function onVis() {
            if (!document.hidden) {
              document.removeEventListener('visibilitychange', onVis);
              release();
            }
          });
        } else {
          release();
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>

    <footer class="relative border-t border-white/10 bg-void text-white">
      <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-10 px-6 py-16 md:flex-row md:items-center">
        <div class="flex items-center gap-4">
          <img src="/brand/mark-white.png" alt="" width="36" height="36" loading="lazy" />
          <div>
            <p class="font-display text-sm font-semibold uppercase text-white" style="letter-spacing: var(--tracking-nav);">
              Integrant
            </p>
            <p class="mt-1 text-xs text-white/40">© 2026 Integrant · Australia</p>
          </div>
        </div>
        <p class="readout text-white/30">Prototype v0.1 — Hero concept preview</p>
      </div>
    </footer>

    <div class="grain" aria-hidden="true"></div>

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
