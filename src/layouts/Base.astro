---
import '@fontsource/titillium-web/400.css';
import '@fontsource/titillium-web/600.css';
import '@fontsource/rajdhani/500.css';
import '@fontsource/rajdhani/600.css';
import '@fontsource/rajdhani/700.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import BrandMark from '../components/ui/BrandMark.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Integrant — Engineering the future of orthopaedic care',
  description = 'Integrant designs and delivers orthopaedic implant systems, biologics and surgical technology across Australia and New Zealand.',
} = Astro.props;

const ogImage = new URL('/brand/og.png', Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Prototype preview: remove before production launch -->
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" sizes="64x64" href="/brand/favicon-64.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Theme resolution runs FIRST and synchronously — this is the only
      // thing standing between the visitor and a flash of the wrong theme.
      // Explicit choice wins; otherwise follow the OS.
      (function () {
        var d = document.documentElement;
        var stored = null;
        try {
          stored = localStorage.getItem('integrant-theme');
        } catch (e) {
          /* private mode / storage disabled — fall through to the OS */
        }
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        d.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#ffffff' : '#000000');
      })();

      // FOUC guard for the hero power-on: hide boot elements only when the
      // motion system will animate them; release after 3s if it never loads.
      (function () {
        var d = document.documentElement;
        var off =
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          new URLSearchParams(location.search).get('motion') === 'off';
        d.dataset.motion = off ? 'off' : 'pending';
        if (off) return;
        // Safety release: show static content if the motion system never
        // arrives. The timer only counts while the page is actually visible
        // (prerendered/background tabs keep the stage dark until revealed).
        var release = function () {
          setTimeout(function () {
            if (d.dataset.motion === 'pending') d.dataset.motion = 'off';
          }, 3000);
        };
        if (document.hidden) {
          document.addEventListener('visibilitychange', function onVis() {
            if (!document.hidden) {
              document.removeEventListener('visibilitychange', onVis);
              release();
            }
          });
        } else {
          release();
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>

    <footer id="contact" data-contrast class="relative bg-base text-ink">
      <div class="mx-auto max-w-6xl px-6 pb-16 pt-28 text-center md:pt-36">
        <h2 class="font-display text-4xl font-bold leading-tight md:text-6xl" data-reveal>
          Partner with Integrant.
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-lg text-ink-2" data-reveal>
          Surgeons, hospitals, distributors and research partners — start the
          conversation.
        </p>
        <div class="mt-10" data-reveal>
          <a href="mailto:info@integrant.com.au" class="cta-solid" data-magnetic>Get in touch</a>
        </div>

        <div class="mt-24 flex flex-col items-start justify-between gap-8 border-t border-hairline pt-10 text-left md:flex-row md:items-center">
          <div class="flex items-center gap-4">
            <BrandMark size={28} class="text-ink" />
            <p class="font-display text-sm font-semibold uppercase text-ink" style="letter-spacing: var(--tracking-nav);">
              Integrant
            </p>
          </div>
          <p class="readout text-ink-3">© 2026 Integrant Pty Ltd · Precision in every dimension</p>
        </div>
      </div>
    </footer>

    <div class="grain" aria-hidden="true"></div>

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
