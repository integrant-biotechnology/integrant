---
// Interactive product viewer — first-party photography as an instrument on a
// lightbox. The cutouts are matte-black hardware with real alpha, so they sit
// on a fixed light specimen plate (grayscale ramp — brand-legal) regardless of
// theme; the hero band around it is always dark ([data-contrast]).
// View cycling: readout tabs, click + arrow keys (roving tabindex), crossfade
// behind both motion gates. Captions stay generic — "Configuration 0N", never
// invented clinical configuration names (TGA).
interface Props {
  name: string;
  views: { src: string; alt: string; small?: string }[];
}
const { name, views } = Astro.props;
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<div class="product-viewer" data-product-viewer>
  <div
    class="pv-plate relative aspect-square"
    role="tabpanel"
    id="pv-panel"
    aria-label={`${name} — product views`}
  >
    {
      views.map((view, i) => (
        <img
          src={view.src}
          srcset={view.small ? `${view.small} 700w, ${view.src} 1400w` : undefined}
          sizes={view.small ? '(min-width: 768px) 320px, 90vw' : undefined}
          alt={view.alt}
          width="1400"
          height="1400"
          loading={i === 0 ? 'eager' : 'lazy'}
          class="pv-view absolute inset-0 h-full w-full object-contain p-7"
          data-pv-view={i}
          data-active={i === 0 ? 'true' : undefined}
          aria-hidden={i === 0 ? undefined : 'true'}
        />
      ))
    }
    <span class="corner corner-tl border-hairline-strong" aria-hidden="true"></span>
    <span class="corner corner-br border-hairline-strong" aria-hidden="true"></span>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex gap-2" role="tablist" aria-label={`${name} views`}>
      {
        views.map((_, i) => (
          <button
            type="button"
            role="tab"
            id={`pv-tab-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls="pv-panel"
            tabindex={i === 0 ? 0 : -1}
            class="pv-tab readout tap-target-sm whitespace-nowrap border border-hairline-strong px-3 py-2 text-xs text-ink-2 transition-colors"
            data-pv-tab={i}
          >
            View {pad(i)}
          </button>
        ))
      }
    </div>
    <p class="readout text-xs text-ink-2" data-pv-caption aria-live="polite">Configuration 01</p>
  </div>
</div>

<style>
  .pv-plate {
    /* fixed grayscale lightbox — black hardware needs a light ground in the
       dark hero. Same ramp as .specimen in global.css. */
    background: linear-gradient(155deg, #f4f4f4 0%, #dcdcdc 58%, #c9c9c9 100%);
    border: 1px solid var(--color-hairline-strong);
  }
  .pv-view {
    opacity: 0;
  }
  .pv-view[data-active] {
    opacity: 1;
  }
  .pv-tab[aria-selected='true'] {
    background: var(--color-ink);
    color: var(--color-base);
    border-color: var(--color-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pv-view {
      transition: opacity 0.45s ease;
    }
    .pv-view[data-active] {
      animation: pv-drift 9s ease-in-out infinite alternate;
    }
  }
  html[data-motion='off'] .pv-view {
    transition: none;
    animation: none;
  }
  @keyframes pv-drift {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.015);
    }
  }
</style>

<script>
  for (const viewer of document.querySelectorAll<HTMLElement>('[data-product-viewer]')) {
    const tabs = [...viewer.querySelectorAll<HTMLButtonElement>('[data-pv-tab]')];
    const views = [...viewer.querySelectorAll<HTMLImageElement>('[data-pv-view]')];
    const caption = viewer.querySelector<HTMLElement>('[data-pv-caption]');

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      views.forEach((view, i) => {
        const active = i === index;
        view.toggleAttribute('data-active', active);
        if (active) view.removeAttribute('aria-hidden');
        else view.setAttribute('aria-hidden', 'true');
      });
      if (caption) caption.textContent = `Configuration ${String(index + 1).padStart(2, '0')}`;
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        let next: number | null = null;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = i === last ? 0 : i + 1;
        else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = i === 0 ? last : i - 1;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = last;
        if (next !== null) {
          event.preventDefault();
          select(next, true);
        }
      });
    });
  }
</script>
