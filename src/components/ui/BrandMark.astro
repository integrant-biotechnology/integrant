---
// The Integrant mark, traced from the 2160px brand source (brand/Integrant
// Logo Black Background.png) into a single compound path. Inline SVG so it
// stays razor-sharp at any size and inherits currentColor — no invert-filter
// hack, no extra request. The solid-disc PNGs remain the source for favicons
// and the OG image, where a filled shape is required.
interface Props {
  size?: number;
  class?: string;
  label?: string; // set when the mark stands alone as the brand presence
}
const { size = 32, class: className, label } = Astro.props;
---

<svg
  viewBox="0 0 1539 1533"
  width={size}
  height={size}
  class={className}
  fill="currentColor"
  fill-rule="evenodd"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
