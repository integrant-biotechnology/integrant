---
import { buildField, renderField, type FieldVariant } from '../../lib/neural-field';

interface Props {
  variant?: FieldVariant;
  /** Distinct per section so neighbours never look duplicated. */
  seed?: number;
  /** Override the theme's whisper level (rarely needed). */
  opacity?: number;
  /** Send impulses along a few fibres — dark bands only, never behind body copy. */
  pulse?: boolean;
  class?: string;
}

const { variant = 'edge', seed = 1, opacity, pulse = false, class: className = '' } = Astro.props;
const geo = buildField(variant, seed);
const markup = renderField(geo, pulse);

// Deterministic per-seed phase + period so neighbouring sections never drift
// in lockstep (synchronised backgrounds read as one repeating texture).
const driftDelay = -(seed % 41);
const driftDuration = 75 + (seed % 5) * 9;

const styleParts = [
  opacity !== undefined ? `--motif-opacity: ${opacity}` : null,
  `--drift-delay: ${driftDelay}s`,
  `--drift-dur: ${driftDuration}s`,
].filter(Boolean);
---

<!--
  Purely decorative: behind content, never interactive, never announced.
  Colour and strength come from the theme (--c-motif / --motif-opacity), so
  it inverts automatically in light mode and inside contrast bands.
-->
<svg
  class={`neural-field ${pulse ? 'is-pulsing' : ''} ${className}`}
  viewBox={`0 0 ${geo.width} ${geo.height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  style={styleParts.join('; ')}
  set:html={markup}
/>
