---
// Trust band — the credibility register as verified-gated slots.
// Counters come from verifiedMetrics (structural TGA gate); the milestone
// rail renders only verifiedMilestones. Two plates then point at where each
// statement can be checked — the TGA register and the research ledger. Nothing here
// can ever render an unverified number — every list is a filtered import.
import { verifiedMetrics } from '../../data/site-metrics';
import { ABOUT, verifiedMilestones } from '../../data/pages/about';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const counters = ['founded', 'systems', 'artg', 'supply']
  .map((id) => verifiedMetrics.find((m) => m.id === id))
  .filter((m): m is NonNullable<typeof m> => Boolean(m));
---

<div class={className}>
  <!-- The cleared claims — same derived figures everywhere on the site -->
  <dl class="grid gap-x-6 gap-y-10 border-y border-hairline py-10 sm:grid-cols-2 md:grid-cols-4" data-reveal-group>
    {
      counters.map((m) => (
        <div data-reveal-item>
          <dd class="font-display text-5xl font-bold tabular-nums text-platinum md:text-6xl">
            {m.kind === 'count' ? <span data-count={m.value}>{m.value}</span> : m.value}
          </dd>
          <dt class="readout mt-3 text-xs text-ink-2">{m.label}</dt>
        </div>
      ))
    }
  </dl>

  <!-- The verified-gated rail -->
  {
    verifiedMilestones.length > 0 && (
      <ol class="mt-12">
        {verifiedMilestones.map((m) => (
          <li class="grid grid-cols-[6rem_1fr] gap-6 border-t border-hairline py-8 last:border-b">
            <span class="font-display text-3xl font-bold tabular-nums">{m.year}</span>
            <div>
              <p class="readout md:text-sm">{m.label}</p>
            </div>
          </li>
        ))}
      </ol>
    )
  }

  <!-- Where to check it: the regulator's register and the company's own
       announcements — links out, never a promise of future content -->
  <div class="mt-12 grid gap-px border border-hairline bg-hairline sm:grid-cols-2" data-reveal>
    <div class="relative flex min-h-44 flex-col justify-between bg-raised p-7">
      <span class="corner corner-tr border-hairline-strong" aria-hidden="true"></span>
      <div>
        <p class="readout text-xs text-ink-2">Regulatory</p>
        <p class="mt-4 text-body leading-relaxed text-ink-2">
          Integrant Pty Ltd is a sponsor on the Australian Register of
          Therapeutic Goods. Its entries are a matter of public record.
        </p>
      </div>
      <p class="mt-6">
        <a href={ABOUT.tgaSponsorRecord} target="_blank" rel="noopener noreferrer" class="readout tap-target-sm text-xs text-ink-2 transition-colors duration-300 hover:text-ink">TGA sponsor record ↗</a>
      </p>
    </div>
    <div class="relative flex min-h-44 flex-col justify-between bg-raised p-7">
      <span class="corner corner-tr border-hairline-strong" aria-hidden="true"></span>
      <div>
        <p class="readout text-xs text-ink-2">Research</p>
        <p class="mt-4 text-body leading-relaxed text-ink-2">
          Research activity is kept on a public ledger: what is being studied,
          how, and with whom — never results.
        </p>
      </div>
      <p class="mt-6">
        <a href="/research" class="readout tap-target-sm text-xs text-ink-2 transition-colors duration-300 hover:text-ink">The ledger →</a>
      </p>
    </div>
  </div>
</div>
