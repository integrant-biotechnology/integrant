---
// Theme control — a precision switch. Track and thumb in strict monochrome
// (no sun/moon; this brand is instruments and light, not weather). The
// switch state is unmistakable at a glance, and the theme change itself
// irises out from the control (View Transitions API, with an instant
// fallback) so the press visibly answers everywhere — including pages
// whose first viewport is a permanent dark band.
---

<button
  type="button"
  class="theme-toggle"
  role="switch"
  aria-checked="false"
  aria-label="Switch to light theme"
  title="Switch theme"
>
  <span class="theme-track" aria-hidden="true">
    <span class="theme-thumb"></span>
  </span>
</button>

<script>
  const KEY = 'integrant-theme';
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');

  const sync = () => {
    const light = root.dataset.theme === 'light';
    toggle?.setAttribute('aria-checked', String(light));
    toggle?.setAttribute('aria-label', `Switch to ${light ? 'dark' : 'light'} theme`);
  };

  const mutate = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'light' ? '#ffffff' : '#050505');
    sync();
    // Let the hero shader repaint for the new palette
    window.dispatchEvent(new CustomEvent('integrant:themechange', { detail: { theme } }));
  };

  const apply = (theme: 'light' | 'dark', animate: boolean) => {
    const reduce =
      matchMedia('(prefers-reduced-motion: reduce)').matches || root.dataset.motion === 'off';

    // The iris: the new theme sweeps out from the switch as an expanding
    // circle. Only on a user press, never on load/sync, never under the
    // motion gates, and only where the View Transitions API exists.
    if (animate && !reduce && typeof document.startViewTransition === 'function') {
      if (toggle) {
        const r = toggle.getBoundingClientRect();
        root.style.setProperty('--iris-x', `${Math.round(r.left + r.width / 2)}px`);
        root.style.setProperty('--iris-y', `${Math.round(r.top + r.height / 2)}px`);
      }
      document.startViewTransition(() => mutate(theme));
      return;
    }

    // Fallback: the 320ms colour crossfade (also skipped under the gates).
    if (animate && !reduce) {
      root.classList.add('theme-animating');
      window.setTimeout(() => root.classList.remove('theme-animating'), 400);
    }
    mutate(theme);
  };

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    try {
      // Dark-first: the site never follows the OS scheme, so every press is
      // an explicit, persisted choice (removing the key would silently fall
      // back to dark and contradict a chosen light theme).
      localStorage.setItem(KEY, next);
    } catch {
      /* choice simply won't persist */
    }
    apply(next, true);
  });

  // Cross-tab sync: another tab's choice applies here immediately, without
  // the transition (background tabs shouldn't flash). A cleared key resolves
  // to the dark-first default.
  window.addEventListener('storage', (event) => {
    if (event.key !== KEY) return;
    const value = event.newValue;
    if (value === 'light' || value === 'dark') {
      apply(value, false);
    } else if (value === null) {
      apply('dark', false);
    }
  });

  sync();
</script>
