---
// Product showcase — four featured systems as a two-up grid of drawing cards,
// then a hairline index completing the full catalogue. Every featured system is shown
// as its ProductPlate technical drawing, so the stack reads as one visual
// language; product photography lives on the detail pages. Copy is the TGA-curated tagline set
// from src/data/products.ts — nothing new is claimed here.
import NeuralField from '../ui/NeuralField.astro';
import ProductPlate from '../ui/ProductPlate.astro';
import { PRODUCTS, getProduct } from '../../data/products';

const FEATURED_SLUGS = ['frameit', 'archit', 'graftit', 'screw-sets'];
const featured = FEATURED_SLUGS.map((slug) => getProduct(slug)!).filter(Boolean);
const rest = PRODUCTS.filter((p) => !FEATURED_SLUGS.includes(p.slug));

// Continuous catalogue index, tied to the product-systems metric
const indexOf = (slug: string) =>
  String(PRODUCTS.findIndex((p) => p.slug === slug) + 1).padStart(2, '0');
const TOTAL = String(PRODUCTS.length);
const NUMBER_WORDS = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen'];
const TOTAL_WORD = NUMBER_WORDS[PRODUCTS.length] ?? TOTAL;

---

<section id="products" class="relative bg-raised text-ink">
  <NeuralField variant="lattice" seed={53} />
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-36">
    <p class="eyebrow" data-reveal>03 — Product systems</p>
    <h2 class="display-1 mt-6" data-reveal>{TOTAL_WORD} systems, engineered as one.</h2>

    <!-- The featured systems: a two-up grid of drawing cards -->
    <div class="mt-14 grid gap-6 sm:grid-cols-2" data-reveal-group>
      {
        featured.map((product) => (
          <a
            href={`/products/${product.line}/${product.slug}`}
            class="showcase-card group relative flex flex-col border border-hairline bg-base transition-colors duration-300"
            data-event="View System"
            data-event-product={product.slug}
            data-event-location="home-showcase"
            data-reveal-item
          >
            <ProductPlate product={product} mode="card" class="border-0" />
            <div class="flex flex-1 flex-col justify-between border-t border-hairline p-7">
              <div>
                <p class="readout text-xs text-platinum">
                  {indexOf(product.slug)} / {TOTAL} — {product.category}
                </p>
                <h3 class="mt-4 font-display text-3xl font-bold text-ink">{product.name}</h3>
                <p class="mt-3 text-body leading-relaxed text-ink-2">{product.tagline}</p>
              </div>
              <p class="readout mt-6 text-xs text-ink-2 transition-colors duration-300 group-hover:text-ink">
                View system →
              </p>
            </div>
          </a>
        ))
      }
    </div>

    <!-- The index: the remaining systems, completing the catalogue -->
    <div class="mt-16 border-t border-hairline md:mt-20" data-reveal-group>
      {
        rest.map((product) => (
          <a
            href={`/products/${product.line}/${product.slug}`}
            class="index-row group grid grid-cols-[3.5rem_1fr_auto] items-baseline gap-4 border-b border-hairline py-5 transition-colors duration-300 md:grid-cols-[4.5rem_1fr_1fr_auto]"
            data-reveal-item
          >
            <span class="font-display text-lg font-bold tabular-nums text-platinum">
              {indexOf(product.slug)}
            </span>
            <span class="font-display text-2xl font-semibold text-ink md:text-3xl">
              {product.name}
            </span>
            <span class="readout hidden text-xs text-ink-2 md:block">{product.category}</span>
            <span class="readout text-xs text-ink-2 transition-colors duration-300 group-hover:text-ink">
              →
            </span>
          </a>
        ))
      }
    </div>

    <p class="mt-12" data-reveal>
      <a href="/products" class="cta-ghost">All {TOTAL} systems →</a>
    </p>
  </div>
</section>

<style>
  @media (hover: hover) {
    .showcase-card:hover {
      border-color: var(--color-hairline-strong);
      background-color: var(--color-inset);
    }
    .index-row:hover {
      background-color: var(--color-raised);
    }
  }
</style>
