---
import NeuralField from '../ui/NeuralField.astro';
// The "platform, not product" section — four disciplines, one system.
// NOTE: placeholder copy, pending content review + TGA compliance sign-off.
const pillars = [
  {
    index: '01',
    title: 'Implant Systems',
    body: 'Surgical-grade fixation engineered for anatomy — from ArchIT to FuseIT.',
    tag: 'TI-6AL-4V · ARTG LISTED',
  },
  {
    index: '02',
    title: 'Biologics & Regeneration',
    body: 'Scaffolds and graft systems designed to work with the body’s own repair.',
    tag: 'FRAMEIT · GRAFTIT',
  },
  {
    index: '03',
    title: 'AI Clinical Software',
    body: 'Neural documentation that writes the operation note while you operate.',
    tag: 'iOS · IN DEVELOPMENT',
  },
  {
    index: '04',
    title: 'Clinical Research',
    body: 'Investigator-led programs, documented on a public ledger: what is studied, how, and with whom.',
    tag: 'AU + NZ',
  },
];
---

<section id="platform" class="relative bg-base text-ink">
  <NeuralField variant="lattice" seed={23} />
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-36">
    <p class="eyebrow" data-reveal>02 — The platform</p>
    <h2 class="display-1 mt-6" data-reveal>Four disciplines. One system.</h2>

    {/* Editorial index rows, not identical boxes: each discipline reads as a
        line item in the platform's table of contents. */}
    <div class="mt-16 border-t border-hairline" data-reveal-group>
      {
        pillars.map((p) => (
          <article
            class="platform-row group relative grid gap-y-4 border-b border-hairline py-10 transition-colors duration-300 md:grid-cols-[90px_1.1fr_1.3fr] md:gap-x-10 md:py-12"
            data-reveal-item
          >
            <p class="font-display text-2xl font-bold tabular-nums text-platinum">{p.index}</p>
            <h3 class="display-2 text-ink">{p.title}</h3>
            <div class="flex flex-col justify-between gap-6">
              <p class="text-body leading-relaxed text-ink-2 md:text-lg">{p.body}</p>
              <p class="readout text-xs text-ink-2">{p.tag}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  @media (hover: hover) {
    .platform-row:hover {
      background-color: var(--color-raised);
    }
    .platform-row:hover > p:first-child {
      color: var(--color-ink);
    }
  }
</style>
