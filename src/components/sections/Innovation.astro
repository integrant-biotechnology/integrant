---
import NeuralField from '../ui/NeuralField.astro';
import OpNote from '../ui/OpNote.astro';
// Dark interlude: the AI chapter. Everything here dramatises the claim in the
// copy — a live vitals trace (bio), an op note writing itself line by line
// (AI), and a listening level meter. All CSS-driven, all behind the global
// reduced-motion gate. Copy stays claim-free.
const chips = ['Neural documentation', 'AI-assisted', 'iOS', 'PDF reports'];
---

<section id="innovation" data-contrast class="relative overflow-hidden bg-base text-ink">
  <NeuralField variant="dense" seed={41} pulse />

  <div class="mx-auto grid max-w-6xl gap-16 px-6 py-20 md:grid-cols-[1fr_280px] md:py-36">
    <div>
      <p class="eyebrow" data-reveal>06 — Innovation &amp; AI</p>
      <h2 class="display-1 mt-6" data-reveal>AI in the operating theatre.</h2>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-2" data-reveal>
        The Integrant app listens to the case and writes the clinical
        documentation — structured, complete, ready to sign.
      </p>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal>
        {
          chips.map((chip) => (
            <span class="readout border border-hairline-strong px-4 py-2.5 text-xs text-ink-2">
              {chip}
            </span>
          ))
        }
      </div>

      <!-- Vitals trace: the baseline draws in on scroll, then a bright pulse
           runs it continuously — a monitor, not a picture of one -->
      <div class="vitals relative mt-16" data-reveal>
        <svg viewBox="0 0 800 140" class="w-full" fill="none" data-draw aria-hidden="true">
          <path
            class="vitals-base text-ink-3"
            d="M 0 70 L 300 70 L 330 70 L 350 34 L 372 116 L 394 10 L 416 128 L 436 50 L 456 70 L 800 70"
            stroke="currentColor"
            stroke-width="1.5"
          ></path>
          <path
            class="vitals-pulse text-ink"
            d="M 0 70 L 300 70 L 330 70 L 350 34 L 372 116 L 394 10 L 416 128 L 436 50 L 456 70 L 800 70"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            data-no-draw
          ></path>
        </svg>
      </div>
    </div>

    <!-- The app, writing. Lines fill in sequence, the caret follows, then the
         draft clears and the next case begins. -->
    <div
      class="relative mx-auto mt-12 w-full max-w-[17rem] md:mt-0 md:w-64"
      data-reveal
      data-parallax="0.12"
      aria-hidden="true"
    >
      <OpNote />
    </div>
  </div>
</section>
