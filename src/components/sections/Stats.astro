---
import NeuralField from '../ui/NeuralField.astro';
import { PRODUCTS, PRODUCT_LINES } from '../../data/products';
import { ANATOMY_AREAS } from '../../data/anatomy-areas';
// Light stats band — Rajdhani numerals counting on entry. Figures are
// computed from the data modules at build time (same source as /about),
// so the two pages can never disagree and the numbers can never drift
// from the catalogue.
const stats = [
  { value: PRODUCTS.length, suffix: '', label: 'Product systems' },
  {
    value: ANATOMY_AREAS.filter((a) => a.productSlugs.length > 0).length,
    suffix: '',
    label: 'Anatomical regions covered',
  },
  { value: PRODUCT_LINES.length, suffix: '', label: 'Divisions — Med · Bio' },
];
---

<section class="relative bg-raised text-ink">
  <NeuralField variant="edge" seed={67} />
  <div class="mx-auto max-w-6xl border-t border-hairline px-6 py-20 md:py-24">
    <div class="grid gap-12 sm:grid-cols-2 md:grid-cols-4" data-reveal>
      {
        stats.map((stat) => (
          <div>
            <p class="font-display text-5xl font-bold tabular-nums text-ink md:text-6xl">
              <span data-count={stat.value}>{stat.value}</span>{stat.suffix}
            </p>
            <p class="readout mt-3 text-ink-3">{stat.label}</p>
          </div>
        ))
      }
      <div>
        <p class="font-display text-5xl font-bold text-ink md:text-6xl">AU·NZ</p>
        <p class="readout mt-3 text-ink-3">Regulated supply</p>
      </div>
    </div>
  </div>
</section>
