---
// Dark stats band — glass panel, Rajdhani numerals counting on entry.
// NOTE: placeholder figures drawn from the site audit, pending confirmation.
const stats = [
  { value: 11, suffix: '+', label: 'Product systems' },
  { value: 8, suffix: '', label: 'Anatomical regions' },
  { value: 2, suffix: '', label: 'Divisions — Med & Bio' },
];
---

<section class="relative bg-canvas text-white">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div
      class="relative grid gap-12 border border-white/10 bg-white/[0.03] px-8 py-14 backdrop-blur-md sm:grid-cols-2 md:grid-cols-4 md:px-12"
      data-reveal
    >
      <span class="corner corner-tl border-white/25" aria-hidden="true"></span>
      <span class="corner corner-tr border-white/25" aria-hidden="true"></span>
      <span class="corner corner-bl border-white/25" aria-hidden="true"></span>
      <span class="corner corner-br border-white/25" aria-hidden="true"></span>

      {
        stats.map((stat) => (
          <div>
            <p class="font-display text-5xl font-bold tabular-nums text-white md:text-6xl">
              <span data-count={stat.value}>{stat.value}</span>{stat.suffix}
            </p>
            <p class="readout mt-3 text-white/40">{stat.label}</p>
          </div>
        ))
      }
      <div>
        <p class="font-display text-5xl font-bold text-white md:text-6xl">AU·NZ</p>
        <p class="readout mt-3 text-white/40">Supply regions</p>
      </div>
    </div>
  </div>
</section>
