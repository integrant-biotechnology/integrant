---
// Product systems — light cards with dark rim-lit visual wells.
// NOTE: placeholder copy; full catalogue lands in Phase 1b from the CMS.
import { getProduct } from '../../data/products';
import NeuralField from '../ui/NeuralField.astro';

const featured = ['archit', 'fuseit', 'graftit']
  .map((slug) => getProduct(slug))
  .filter((p) => p !== undefined)
  .map((p, i) => ({
    name: p.name,
    line: p.category,
    blurb: p.tagline,
    href: `/products/${p.line}/${p.slug}`,
    tilt: [18, 4, -12][i] ?? 0,
  }));
---

<section id="products" class="relative bg-base text-ink">
  <NeuralField variant="lattice" seed={53} />
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-36">
    <p class="readout md:text-sm text-ink-2" data-reveal>05 — Product systems</p>
    <h2 class="mt-6 font-display text-4xl font-bold leading-tight sm:text-5xl md:text-6xl" data-reveal>
      Precision, instrument by instrument.
    </h2>

    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {
        featured.map((product) => (
          <a href={product.href} class="group block border border-hairline bg-raised" data-reveal>
            <div
              class="relative h-56 overflow-hidden"
              style="background:
                radial-gradient(120% 130% at 50% -35%, rgb(255 255 255 / 0.16), transparent 60%),
                #020202;"
            >
              <span
                class="absolute left-1/2 top-10 block h-36 w-2.5 rounded-full"
                style={`transform: rotate(${product.tilt}deg);
                  background: linear-gradient(180deg, #d9d9d9, #3a3a3a);`}
                aria-hidden="true"
              ></span>
            </div>
            {/* Category sits above the title — sharing a row with the link
                collided once wide-tracked labels wrapped */}
            <div class="p-7">
              <p class="readout text-xs text-ink-3">{product.line}</p>
              <h3 class="mt-4 font-display text-3xl font-bold text-ink">{product.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-2">{product.blurb}</p>
              <p class="readout mt-8 text-xs text-ink-3 transition-colors duration-300 group-hover:text-ink">
                View system →
              </p>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-12" data-reveal>
      <a
        href="/products"
        class="readout -mt-5 inline-flex items-center gap-3 border-b border-hairline-strong pb-2 pt-5 text-xs text-ink-2 transition-colors duration-300 hover:border-ink hover:text-ink"
      >
        View all systems →
      </a>
    </div>
  </div>
</section>
