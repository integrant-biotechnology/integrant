---
// Product systems — light cards with dark rim-lit visual wells.
// NOTE: placeholder copy; full catalogue lands in Phase 1b from the CMS.
const products = [
  {
    name: 'ArchIT',
    line: 'Med-Tech · Fixation',
    blurb: 'Arch reconstruction system, titanium fixation platform.',
    tilt: 18,
  },
  {
    name: 'FuseIT',
    line: 'Med-Tech · Fusion',
    blurb: 'Ankle and hindfoot fusion engineered for stability under load.',
    tilt: 4,
  },
  {
    name: 'GraftIT',
    line: 'Bio-Tech · Regeneration',
    blurb: 'Biological scaffold supporting graft integration.',
    tilt: -12,
  },
];
---

<section id="products" class="relative bg-white text-ink">
  <div class="mx-auto max-w-6xl px-6 py-28 md:py-36">
    <p class="readout text-ink/45" data-reveal>05 — Product systems</p>
    <h2 class="mt-6 font-display text-4xl font-bold leading-tight md:text-5xl" data-reveal>
      Precision, instrument by instrument.
    </h2>

    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {
        products.map((product) => (
          <article class="group border border-ink/10 bg-surface" data-reveal>
            <div
              class="relative h-56 overflow-hidden"
              style="background:
                radial-gradient(120% 130% at 50% -35%, rgb(255 255 255 / 0.16), transparent 60%),
                #020202;"
            >
              <span
                class="absolute left-1/2 top-10 block h-36 w-2.5 rounded-full"
                style={`transform: rotate(${product.tilt}deg);
                  background: linear-gradient(180deg, #d9d9d9, #3a3a3a);`}
                aria-hidden="true"
              ></span>
            </div>
            <div class="p-7">
              <h3 class="font-display text-3xl font-bold text-ink">{product.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/60">{product.blurb}</p>
              <div class="mt-8 flex items-center justify-between">
                <p class="readout text-[10px] text-ink/40">{product.line}</p>
                <p class="readout text-[10px] text-ink/40 transition-colors duration-300 group-hover:text-ink">
                  View system →
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="readout mt-10 text-[10px] text-ink/30" data-reveal>
      Full catalogue — browse by anatomy or product line — arrives with the build phase
    </p>
  </div>
</section>
