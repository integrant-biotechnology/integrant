---
// Hero metrics strip — the credibility register pinned to the hero's bottom
// edge. Renders ONLY verifiedMetrics (the structural TGA gate in
// src/data/site-metrics.ts); pass `ids` to choose which four appear.
// Numeric values carry data-count so the existing counter animation picks
// them up; server-rendered text is the static ?motion=off fallback.
import { verifiedMetrics } from '../../data/site-metrics';

interface Props {
  ids?: string[];
  class?: string;
}

const { ids = ['systems', 'regions', 'divisions', 'supply'], class: className = '' } = Astro.props;

const metrics = ids
  .map((id) => verifiedMetrics.find((m) => m.id === id))
  .filter((m): m is NonNullable<typeof m> => Boolean(m));
---

<div class={`hero-metrics boot-hide border-t border-hairline ${className}`}>
  <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-4 px-6 py-4 md:grid-cols-4 md:gap-y-5 md:py-6">
    {
      metrics.map((m) => (
        <div class="text-center md:text-left">
          <dd class="font-display text-3xl font-bold tabular-nums text-platinum md:text-4xl">
            {m.kind === 'count' ? <span data-count={m.value}>{m.value}</span> : m.value}
          </dd>
          <dt class="readout mt-1 text-xs text-ink-2 md:mt-1.5">{m.label}</dt>
        </div>
      ))
    }
  </dl>
</div>
