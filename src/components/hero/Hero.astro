---
// Full-viewport hero — white volumetric light in a black void.
// Tiers: T3/T2 WebGL shader · T1 CSS/SVG rays · T0 static (reduced motion).
import BrandMark from '../ui/BrandMark.astro';
import HeroMetrics from './HeroMetrics.astro';
---

<section
  class="hero relative flex min-h-[100svh] items-center justify-center overflow-hidden bg-base text-ink"
  data-hero
  data-tier="0"
>
  <!-- Static placeholder: paints instantly, no JS, no layout shift -->
  <div class="hero-bg absolute inset-0" aria-hidden="true"></div>

  <!-- T1 fallback: compositor-only ray drift -->
  <svg
    class="hero-rays absolute inset-0 h-full w-full text-ink"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="ray-fade" x1="0" y1="0" x2="0.7" y2="1">
        <stop offset="0" stop-color="currentColor" stop-opacity="0.14"></stop>
        <stop offset="0.55" stop-color="currentColor" stop-opacity="0.03"></stop>
        <stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    <g fill="url(#ray-fade)">
      <polygon points="8,-5 30,-5 78,105 48,105"></polygon>
      <polygon points="-2,-5 10,-5 40,105 22,105"></polygon>
      <polygon points="26,-5 34,-5 96,105 82,105"></polygon>
    </g>
  </svg>

  <!-- T2/T3: OGL god-rays canvas, fades in after first frame -->
  <canvas
    class="hero-canvas absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000"
    aria-hidden="true"
  ></canvas>

  <!-- Content -->
  <div class="hero-content relative z-10 mx-auto max-w-5xl px-6 pb-48 pt-28 text-center md:pb-40">
    {/* Mark alone — the wordmark already lives in the nav directly above;
        repeating it here read as a template lockup, not a brand moment */}
    <BrandMark size={44} class="hero-logo boot-hide mx-auto mb-8 text-ink md:mb-9" label="Integrant" />
    <p class="hero-eyebrow boot-hide readout text-ink-3">
      Orthopaedic Med-Tech · Bio-Tech · AI
    </p>
    <h1 class="hero-h1 boot-hide display-hero mt-6 text-ink">
      Where biology becomes intelligence.
    </h1>
    <p class="hero-sub boot-hide mx-auto mt-6 max-w-2xl text-lg text-ink-2 md:text-xl">
      Implant systems, biologics and AI clinical software — one platform,
      engineered in Sydney for Australian and New Zealand theatres.
    </p>
    <div class="hero-cta-wrap boot-hide mt-9 flex flex-wrap items-center justify-center gap-4">
      <a href="#platform" class="cta-solid" data-magnetic>Explore the platform</a>
      <a href="/contact" class="cta-ghost">Request a meeting</a>
    </div>
  </div>

  <!-- White bloom flood: the darkness→clarity hand-off, scrubbed on scroll -->
  <div class="hero-bloom" aria-hidden="true"></div>

  <!-- The credibility register: verified metrics only, pinned to the hero's
       bottom edge (outside .hero-content, so the pin's content exit doesn't
       drag it — it gets its own faster exit in motion.ts) -->
  <HeroMetrics class="absolute inset-x-0 bottom-0 z-10" />
</section>

<script>
  import { detectTier, applyTier } from './hero-boot';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('.hero-canvas');

  if (hero && canvas) {
    const params = new URLSearchParams(window.location.search);
    const forced = params.get('tier');
    const tier = forced !== null ? (Number(forced) as 0 | 1 | 2 | 3) : detectTier();
    applyTier(hero, canvas, tier);

    // Live downgrade if the user enables reduced motion mid-session
    window
      .matchMedia('(prefers-reduced-motion: reduce)')
      .addEventListener('change', (e) => {
        if (e.matches) applyTier(hero, canvas, 0);
      });
  }
</script>
