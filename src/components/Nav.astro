---
// Absolute paths so the nav works from every route, not just the homepage.
// Sections that are not yet standalone pages deep-link into the homepage.
const links = [
  { href: '/products', label: 'Products' },
  { href: '/#innovation', label: 'Innovation' },
  { href: '/#surgeons', label: 'For Surgeons' },
  { href: '/#research', label: 'Research' },
  { href: '/#about', label: 'About' },
];
---

<header class="site-nav fixed inset-x-0 top-0 z-50" data-scrolled="false">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 md:py-5">
    <a href="/" class="flex items-center gap-3 text-white" aria-label="Integrant home">
      <img src="/brand/mark-white.png" alt="" width="34" height="34" />
      <span class="font-display text-sm font-semibold uppercase" style="letter-spacing: var(--tracking-nav);">
        Integrant
      </span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-8 lg:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="readout text-white/55 transition-colors duration-300 hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a href="/#contact" class="cta-ghost">Enquire</a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-nav');
  if (header) {
    let ticking = false;
    const update = () => {
      header.dataset.scrolled = String(window.scrollY > 24);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    update();
  }
</script>
