---
import ThemeToggle from './ui/ThemeToggle.astro';
import BrandMark from './ui/BrandMark.astro';

// Absolute paths so the nav works from every route, not just the homepage.
// Links only appear here once their destination actually exists — a nav item
// that scrolls nowhere is worse than one that isn't there yet. "For Surgeons"
// and "Clinical Research" rejoin the nav when those pages ship (CLAUDE.md §4).
const links = [
  { href: '/products', label: 'Products', match: '/products' },
  { href: '/#innovation', label: 'Innovation' },
  { href: '/#about', label: 'About' },
];

const path = Astro.url.pathname;
const isCurrent = (link: (typeof links)[number]) =>
  link.match ? path === link.match || path.startsWith(`${link.match}/`) : false;
---

<header class="site-nav fixed inset-x-0 top-0 z-50" data-scrolled="false" data-theme="dark" data-hidden="false">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 md:py-5">
    <a href="/" class="nav-link tap-target flex items-center gap-3" aria-label="Integrant — home">
      <BrandMark size={28} class="nav-mark" />
      <span
        class="nav-wordmark font-display text-sm font-semibold uppercase"
        style="letter-spacing: var(--tracking-nav);"
      >
        Integrant
      </span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-8 xl:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            {/* colour comes from the nav theme vars — a hardcoded text-*
                utility would outrank them and stay white on light sections */}
            class="nav-link tap-target readout transition-colors duration-300"
            aria-current={isCurrent(link) ? 'page' : undefined}
            data-current={isCurrent(link) ? 'true' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-4">
      <ThemeToggle />
      <a href="/contact" class="cta-ghost hidden sm:inline-flex">Enquire</a>

      <!-- Mobile menu trigger -->
      <button
        type="button"
        class="nav-toggle xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <span class="nav-progress" aria-hidden="true"></span>
</header>

<!-- Mobile menu: full-viewport panel, hidden from AT until opened -->
<div id="mobile-menu" data-contrast class="mobile-menu" data-open="false" hidden>
  <nav aria-label="Mobile" class="mx-auto flex h-full max-w-7xl flex-col justify-between px-6 pb-12 pt-28">
    <ul class="space-y-2">
      {
        links.map((link, i) => (
          <li class="mobile-menu-item overflow-hidden" style={`--i: ${i}`}>
            <a
              href={link.href}
              class="block border-b border-hairline py-5 font-display text-4xl font-bold text-ink"
              aria-current={isCurrent(link) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="mobile-menu-item overflow-hidden" style={`--i: ${links.length}`}>
        <a
          href="/contact"
          class="block border-b border-hairline py-5 font-display text-4xl font-bold text-ink"
        >
          Enquire
        </a>
      </li>
    </ul>

    <p class="readout mobile-menu-item text-ink-3" style={`--i: ${links.length + 1}`}>
      Orthopaedic Med-Tech · Bio-Tech · AI
    </p>
  </nav>
</div>

<script>
  const header = document.querySelector<HTMLElement>('.site-nav');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');

  // --- bar state: solidity, theme, retraction, scroll progress ---
  if (header) {
    const progress = header.querySelector<HTMLElement>('.nav-progress');
    let ticking = false;
    let lastY = window.scrollY;

    // The bar is fixed, so it can't inherit a contrast band's scoped tokens —
    // it derives its own theme instead. Over a contrast band the palette is
    // always dark; everywhere else it follows the global theme.
    const themeAt = (): 'light' | 'dark' => {
      const y = header.getBoundingClientRect().bottom + 4;
      const el = document.elementFromPoint(window.innerWidth / 2, y);
      if (el?.closest('[data-contrast]')) return 'dark';
      return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    };

    const update = () => {
      const y = window.scrollY;
      header.dataset.scrolled = String(y > 24);
      header.dataset.theme = themeAt();

      // Retract on downward scroll, but only well past the hero so the
      // opening sequence is never interrupted. Never retract while the
      // mobile menu is open.
      const menuOpen = document.documentElement.classList.contains('menu-open');
      const pastHero = y > window.innerHeight * 1.5;
      const scrollingDown = y > lastY + 4;
      const scrollingUp = y < lastY - 4;
      if (menuOpen || !pastHero || scrollingUp) header.dataset.hidden = 'false';
      else if (scrollingDown) header.dataset.hidden = 'true';

      if (progress) {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.setProperty('--progress', String(max > 0 ? Math.min(y / max, 1) : 0));
      }

      lastY = y;
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    // A theme switch changes the bar's palette without any scrolling
    window.addEventListener('integrant:themechange', onScroll);
    update();
  }

  // --- mobile menu ---
  if (toggle && menu) {
    let open = false;

    const setOpen = (next: boolean) => {
      if (next === open) return;
      open = next;

      // `hidden` keeps the panel out of the a11y tree and tab order when closed.
      // Flush styles synchronously (a forced reflow) rather than waiting on
      // rAF — rAF is throttled in background/hidden tabs, which would leave
      // the menu stuck half-open.
      if (open) {
        menu.hidden = false;
        void menu.offsetHeight;
      }
      menu.dataset.open = String(open);

      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.dataset.open = String(open);
      document.documentElement.classList.toggle('menu-open', open);

      // Lenis owns scrolling — stop it, and lock the native scrollbar too
      const lenis = (window as unknown as { __lenis?: { stop(): void; start(): void } }).__lenis;
      if (open) lenis?.stop();
      else lenis?.start();

      if (open) {
        // focus only lands once the panel is actually visible
        menu.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
      } else {
        toggle.focus();
        // wait for the close transition before removing from the tree
        window.setTimeout(() => {
          if (!open) menu.hidden = true;
        }, 400);
      }
    };

    toggle.addEventListener('click', () => setOpen(!open));

    // Any navigation closes the panel (same-page anchors don't unload)
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open) setOpen(false);
    });

    // Returning to desktop width must never leave the page scroll-locked
    const desktop = window.matchMedia('(min-width: 1280px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
