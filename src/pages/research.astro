---
// /research — "The Ledger". The most austere page on the site, deliberately:
// research ACTIVITY as a ruled table. Rows come exclusively from
// publishedResearch (complianceReviewed === true, enforced in data/research
// .ts) — an unreviewed row cannot render. No hosted PDFs, ever; citations
// link out to publisher DOIs once cleared. With zero reviewed rows the
// ledger shows its designed preparation state, so the URL can exist (and
// be linked) before the first row clears review.
import Base from '../layouts/Base.astro';
import SubpageHero from '../components/SubpageHero.astro';
import NeuralField from '../components/ui/NeuralField.astro';
import { publishedResearch } from '../data/research';
---

<Base
  footerCta={false}
  title="Clinical research activity — Integrant Biotechnology"
  ogImage="/og/research.png"
  description="Integrant Biotechnology's clinical research activity — programs, methodology and partnerships. This page describes activity; it does not report clinical outcomes."
>
  <SubpageHero
    title="Research."
    kicker="Activity · Methodology · Partnerships"
    lede="A ledger of research activity around the platform. Descriptions cover what is being studied and how — never results."
    crumbs={[{ label: 'Integrant', href: '/' }, { label: 'Research' }]}
    docRef="Doc 05 — Research"
    meta={[
      { label: 'Standard', value: 'Compliance-reviewed' },
      { label: 'Scope', value: 'Activity, not outcomes' },
      { label: 'Citations', value: 'Publisher DOI only' },
    ]}
    seed={239}
    variant="imaging"
  />

  <!-- The constraint, stated first: leading with the rule is the credibility -->
  <section class="relative bg-base text-ink">
    <div class="mx-auto max-w-6xl px-6 py-8 md:py-10">
      <p class="readout border-y border-hairline py-6 text-xs leading-relaxed text-ink-2 md:text-sm">
        This page describes research activity. It does not report clinical outcomes.
      </p>
    </div>
  </section>

  <!-- 01 · The standard — the publication bar, as content -->
  <section class="relative bg-base text-ink">
    <NeuralField variant="edge" seed={238} />
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-28">
      <p class="eyebrow" data-reveal>01 — The standard</p>
      <h2 class="display-1 mt-6 max-w-3xl" data-reveal>Published the hard way.</h2>

      <div class="mt-14 grid gap-px border border-hairline bg-hairline md:grid-cols-3" data-reveal-group>
        {
          [
            {
              n: '01',
              title: 'Activity, not outcomes',
              body: 'Entries describe what is studied and how — methodology and partners, never results.',
            },
            {
              n: '02',
              title: 'Reviewed before published',
              body: 'No entry renders before compliance review completes. The gate is structural, not editorial.',
            },
            {
              n: '03',
              title: 'Publisher records only',
              body: 'Citations link to the publisher DOI. Nothing is hosted here.',
            },
          ].map((plate) => (
            <div class="relative flex min-h-56 flex-col bg-raised p-7" data-reveal-item>
              <span class="corner corner-tr border-hairline-strong" aria-hidden="true" />
              <p class="font-display text-lg font-bold tabular-nums text-platinum">{plate.n}</p>
              <h3 class="mt-5 font-display text-2xl font-semibold text-ink">{plate.title}</h3>
              <p class="mt-4 text-body leading-relaxed text-ink-2">{plate.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative bg-raised text-ink">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="eyebrow" data-reveal>02 — The ledger</p>
      <h2 class="display-1 mt-6 max-w-2xl" data-reveal>
        {publishedResearch.length > 0 ? 'Activity, on the record.' : 'What each entry records.'}
      </h2>

      {
        publishedResearch.length > 0 ? (
          <div class="mt-10 border-t border-hairline-strong">
            <div class="hidden grid-cols-[6rem_1fr_10rem_14rem] gap-6 border-b border-hairline py-4 md:grid" aria-hidden="true">
              <span class="readout text-xs text-ink-2">REF</span>
              <span class="readout text-xs text-ink-2">TITLE</span>
              <span class="readout text-xs text-ink-2">STATUS</span>
              <span class="readout text-xs text-ink-2">PARTNERS</span>
            </div>
            {publishedResearch.map((item) => (
              <details class="plate border-b border-hairline">
                <summary class="tap-target grid gap-3 py-6 md:grid-cols-[6rem_1fr_10rem_14rem] md:items-baseline md:gap-6">
                  <span class="readout text-xs text-ink-2">{item.ref}</span>
                  <span class="font-display text-xl font-semibold text-ink">{item.title}</span>
                  <span class="readout text-xs text-ink-2">[ {item.status.toUpperCase()} ]</span>
                  <span class="flex items-center justify-between gap-4">
                    <span class="readout text-xs text-ink-2">{item.partners.join(' · ') || '—'}</span>
                    <span class="plate-toggle font-display text-xl font-semibold text-ink-2" aria-hidden="true">+</span>
                  </span>
                </summary>
                <div class="grid gap-8 pb-8 md:grid-cols-2">
                  <p class="leading-relaxed text-ink-2">{item.summary}</p>
                  <div>
                    {item.methodology && <p class="leading-relaxed text-ink-2">{item.methodology}</p>}
                    {item.doi && (
                      <a href={item.doi} rel="noopener" class="readout tap-target-sm mt-4 inline-block text-xs text-ink-2 transition-colors hover:text-ink">
                        PUBLISHER RECORD →
                      </a>
                    )}
                  </div>
                </div>
              </details>
            ))}
          </div>
        ) : (
          <dl class="mt-10 border-t border-hairline-strong" data-reveal>
            {/* No rows cleared yet: the section explains what an entry
                records rather than showing an empty register. */}
            {[
              ['Reference', 'A fixed ledger number, so an entry can be cited and followed over time.'],
              ['Programme', 'What is being studied and the question the work is designed to answer.'],
              ['Method', 'Study design and the partners carrying it out — never interim or final results.'],
              ['Record', 'A link to the publisher DOI once the work is in print. Papers are not hosted here.'],
            ].map(([term, detail]) => (
              <div class="grid gap-2 border-b border-hairline py-6 md:grid-cols-[14rem_1fr] md:items-baseline md:gap-6">
                <dt class="readout text-xs text-ink-2">{term}</dt>
                <dd class="text-body leading-relaxed text-ink-2">{detail}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <!-- Collaboration close -->
  <section class="relative bg-raised text-ink">
    <NeuralField variant="edge" seed={241} />
    <div class="mx-auto max-w-6xl border-t border-hairline px-6 py-16 md:py-28">
      <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <h2 class="display-1" data-reveal>
            Research collaboration.
          </h2>
          <p class="mt-6 max-w-xl text-lg text-ink-2" data-reveal>
            Institutions and clinical teams interested in investigator-led work
            with the platform can reach the team directly.
          </p>
        </div>
        <div data-reveal>
          <a href="/contact?channel=research" class="cta-solid" data-magnetic data-event="Request Meeting" data-event-location="research">Research enquiry</a>
        </div>
      </div>
    </div>
  </section>
</Base>
