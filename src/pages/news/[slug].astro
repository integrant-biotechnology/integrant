---
// /news/[slug] — one announcement: a neutral account, then the link to the
// original release, which remains the record. Pages are generated only for
// publishedNews; with none published this route builds nothing.
import Base from '../../layouts/Base.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import NeuralField from '../../components/ui/NeuralField.astro';
import { publishedNews, BOILERPLATE, MEDIA_CONTACT, type NewsItem } from '../../data/news';
import { formatDate, formatDateShort } from '../../lib/format-date';

export function getStaticPaths() {
  return publishedNews.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

interface Props {
  item: NewsItem;
}

const { item } = Astro.props;
const site = (Astro.site ?? Astro.url).toString().replace(/\/$/, '');
const url = `${site}/news/${item.slug}`;

const index = publishedNews.findIndex((n) => n.slug === item.slug);
const newer = index > 0 ? publishedNews[index - 1] : undefined;
const older = index < publishedNews.length - 1 ? publishedNews[index + 1] : undefined;

const jsonLd = [
  {
    '@type': 'NewsArticle',
    headline: item.title,
    description: item.summary,
    datePublished: item.date,
    dateModified: item.date,
    url,
    mainEntityOfPage: url,
    image: `${site}/og/news-${item.slug}.png`,
    author: { '@type': 'Organization', name: 'Integrant', url: site },
    publisher: {
      '@type': 'Organization',
      name: 'Integrant',
      logo: { '@type': 'ImageObject', url: `${site}/brand/logo-512.png` },
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Integrant', item: site },
      { '@type': 'ListItem', position: 2, name: 'News', item: `${site}/news` },
      { '@type': 'ListItem', position: 3, name: item.title, item: url },
    ],
  },
];
---

<Base
  title={`${item.title} — Integrant`}
  description={item.summary}
  ogImage={`/og/news-${item.slug}.png`}
  ogType="article"
  publishedTime={item.date}
  jsonLd={jsonLd}
  footerCta={false}
>
  <SubpageHero
    title={item.title}
    titleSize="compact"
    breadcrumbLd={false}
    kicker={`${item.category} · ${formatDate(item.date)}`}
    crumbs={[{ label: 'Integrant', href: '/' }, { label: 'News', href: '/news' }, { label: formatDateShort(item.date) }]}
    docRef="Doc 10 — News"
    meta={[
      { label: 'Date', value: formatDate(item.date) },
      { label: 'Type', value: item.category },
      { label: 'Source', value: item.sourceName },
    ]}
    seed={317 + index}
    variant="lattice"
  />

  <article class="relative bg-raised text-ink">
    <NeuralField variant="edge" seed={331 + index} />
    <div class="relative mx-auto max-w-6xl px-6 py-16 md:py-28">
      <div class="grid gap-12 md:grid-cols-[1fr_minmax(280px,340px)] md:gap-16">
        <div>
          <p class="max-w-2xl font-display text-2xl font-semibold leading-snug text-ink md:text-3xl">
            {item.summary}
          </p>
          <div class="mt-10 max-w-2xl space-y-6">
            {item.body.map((paragraph) => <p class="text-lg leading-relaxed text-ink-2">{paragraph}</p>)}
          </div>

          <div class="mt-12 border-t border-hairline pt-8">
            <p class="readout text-xs text-ink-2">Original release</p>
            <p class="mt-3 max-w-2xl text-body leading-relaxed text-ink-2">
              This page is a summary. The full announcement is published by {item.sourceName} and remains the record.
            </p>
            <a
              href={item.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="cta-ghost mt-6 inline-flex"
            >
              Read on {item.sourceName} ↗
            </a>
          </div>
        </div>

        <aside class="md:pt-2">
          <div class="border border-hairline bg-base p-7">
            <p class="readout text-xs text-ink-2">About Integrant</p>
            <p class="mt-4 text-body leading-relaxed text-ink-2">{BOILERPLATE}</p>
          </div>
          <div class="mt-6 border border-hairline bg-base p-7">
            <p class="readout text-xs text-ink-2">Media contact</p>
            <a
              href={`mailto:${MEDIA_CONTACT.email}`}
              class="tap-target-sm mt-3 inline-flex items-center font-display text-xl font-semibold text-ink underline decoration-[var(--color-hairline-strong)] underline-offset-8 transition-colors duration-300 hover:decoration-current"
              data-event="Email Click"
              data-event-location="news-article"
            >
              {MEDIA_CONTACT.email}
            </a>
          </div>
        </aside>
      </div>

      <p class="mt-14 max-w-3xl text-sm leading-relaxed text-ink-2">
        Statements about a proposed listing, capital raising or future plans
        are forward-looking, reflect intentions at the date of the
        announcement, and may change. Nothing on this page is an offer of
        securities or financial product advice.
      </p>

      <!-- Pager -->
      <nav aria-label="More news" class="mt-14 grid gap-px border border-hairline bg-hairline sm:grid-cols-2">
        {
          [
            { item: older, label: '← Earlier' },
            { item: newer, label: 'Later →' },
          ].map((slot) =>
            slot.item ? (
              <a href={`/news/${slot.item.slug}`} class="group flex min-h-32 flex-col justify-between bg-base p-7">
                <span class="readout text-xs text-ink-2 transition-colors duration-300 group-hover:text-ink">{slot.label}</span>
                <span class="mt-4 font-display text-xl font-semibold text-ink">{slot.item.title}</span>
              </a>
            ) : (
              <a href="/news" class="group flex min-h-32 flex-col justify-between bg-base p-7">
                <span class="readout text-xs text-ink-2 transition-colors duration-300 group-hover:text-ink">All news →</span>
                <span class="mt-4 font-display text-xl font-semibold text-ink">The newsroom</span>
              </a>
            ),
          )
        }
      </nav>
    </div>
  </article>
</Base>
