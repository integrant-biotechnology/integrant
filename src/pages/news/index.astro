---
// /news — the newsroom. Announcements as a dated ledger, each linked to its
// original source, followed by the media kit and the media contact. Rows
// come exclusively from publishedNews (data/news.ts); summaries are neutral
// rewrites, never the promotional wording of the original release.
import Base from '../../layouts/Base.astro';
import SubpageHero from '../../components/SubpageHero.astro';
import NeuralField from '../../components/ui/NeuralField.astro';
import { publishedNews, BOILERPLATE, MEDIA_CONTACT } from '../../data/news';
import { formatDateShort } from '../../lib/format-date';

const latest = publishedNews[0];

const KIT = [
  { label: 'Wordmark lockup', detail: 'White on transparent · PNG', href: '/brand/logo-white.png', file: 'integrant-logo-white.png' },
  { label: 'Brand mark', detail: 'White on transparent · PNG', href: '/brand/mark-white.png', file: 'integrant-mark-white.png' },
  { label: 'Square logo', detail: '512 × 512 · PNG', href: '/brand/logo-512.png', file: 'integrant-logo-512.png' },
];

const FACTS = [
  { label: 'Company', value: 'Integrant Pty Ltd' },
  { label: 'Founded', value: '2015' },
  { label: 'Headquarters', value: 'Sydney, Australia' },
  { label: 'Focus', value: 'Orthopaedic med-tech · Bio-tech · AI' },
];
---

<Base
  title="News — Integrant"
  ogImage="/og/news.png"
  description="Company announcements and press releases from Integrant, with the media kit and media contact."
  footerCta={false}
>
  <SubpageHero
    title="News."
    kicker="Announcements · Press · Media"
    lede="Company announcements and press releases, each linked to its original source."
    crumbs={[{ label: 'Integrant', href: '/' }, { label: 'News' }]}
    docRef="Doc 10 — News"
    meta={[
      ...(latest ? [{ label: 'Latest', value: formatDateShort(latest.date) }] : []),
      { label: 'Media', value: MEDIA_CONTACT.email },
    ]}
    seed={307}
    variant="lattice"
  />

  <!-- 01 · Announcements -->
  {
    publishedNews.length > 0 && (
      <section class="relative bg-raised text-ink">
        <NeuralField variant="edge" seed={311} />
        <div class="relative mx-auto max-w-6xl px-6 py-16 md:py-32">
          <p class="eyebrow" data-reveal>01 — Announcements</p>
          <h2 class="display-1 mt-6 max-w-2xl" data-reveal>On the record.</h2>

          <ol class="mt-12 border-t border-hairline-strong" data-reveal>
            {publishedNews.map((item) => (
              <li class="border-b border-hairline">
                <a
                  href={`/news/${item.slug}`}
                  class="group grid gap-3 py-8 md:grid-cols-[10rem_1fr_auto] md:items-baseline md:gap-8"
                >
                  <time datetime={item.date} class="readout text-xs text-ink-2">{formatDateShort(item.date)}</time>
                  <span>
                    <span class="block font-display text-2xl font-semibold text-ink md:text-3xl">{item.title}</span>
                    <span class="mt-3 block max-w-2xl text-body leading-relaxed text-ink-2">{item.summary}</span>
                    <span class="readout mt-4 block text-xs text-ink-2">{item.category} · {item.sourceName}</span>
                  </span>
                  <span class="readout shrink-0 whitespace-nowrap text-xs text-ink-2 transition-colors duration-300 group-hover:text-ink">
                    Read →
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <!-- 02 · Media kit -->
  <section class="relative bg-base text-ink">
    <NeuralField variant="imaging" seed={313} />
    <div class="relative mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="eyebrow" data-reveal>02 — Media kit</p>
      <h2 class="display-1 mt-6 max-w-2xl" data-reveal>For editorial use.</h2>

      <div class="mt-12 grid gap-12 md:grid-cols-[1fr_minmax(300px,380px)] md:gap-16">
        <div data-reveal>
          <h3 class="readout text-xs text-ink-2">About Integrant</h3>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-2">{BOILERPLATE}</p>

          <dl class="mt-10 max-w-2xl border-t border-hairline">
            {FACTS.map((fact) => (
              <div class="flex items-baseline justify-between gap-6 border-b border-hairline py-4">
                <dt class="readout text-xs text-ink-2">{fact.label}</dt>
                <dd class="text-right font-display text-body font-semibold text-ink">{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div data-reveal>
          <h3 class="readout text-xs text-ink-2">Logo files</h3>
          <ul class="mt-5 border-t border-hairline">
            {KIT.map((asset) => (
              <li class="border-b border-hairline">
                <a href={asset.href} download={asset.file} class="group flex items-center justify-between gap-6 py-5">
                  <span>
                    <span class="block font-display text-xl font-semibold text-ink">{asset.label}</span>
                    <span class="readout mt-1 block text-xs text-ink-2">{asset.detail}</span>
                  </span>
                  <span class="readout shrink-0 whitespace-nowrap text-xs text-ink-2 transition-colors duration-300 group-hover:text-ink">
                    Download ↓
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm leading-relaxed text-ink-2">
            The Integrant mark is black or white only. Please do not recolour,
            redraw or place it on a photograph without a solid field.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Media contact close -->
  <section class="relative bg-raised text-ink">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-28">
      <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <p class="eyebrow" data-reveal>03 — Media contact</p>
          <h2 class="display-1 mt-6" data-reveal>Press enquiries.</h2>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-2" data-reveal>
            Interview requests, images and background on the company and its
            systems. Journalists on deadline should say so in the subject line.
          </p>
        </div>
        <a
          href={`mailto:${MEDIA_CONTACT.email}`}
          class="cta-solid"
          data-magnetic
          data-event="Email Click"
          data-event-location="news-media-contact"
          data-reveal
        >
          {MEDIA_CONTACT.email}
        </a>
      </div>
    </div>
  </section>
</Base>
