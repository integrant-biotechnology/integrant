---
// /about — "The Record". The company rendered as a technical document:
// thesis, founder plate, the BIO+AI formula, careers, verifiable facts.
// The milestone rail (ABOUT.milestones) renders only verified entries.
// Legacy /about-us content is deliberately unused: it was Elementor demo
// content with a fabricated team (content-archive/INDEX.md).
import Base from '../layouts/Base.astro';
import SubpageHero from '../components/SubpageHero.astro';
import NeuralField from '../components/ui/NeuralField.astro';
import TrustBand from '../components/ui/TrustBand.astro';
import { ABOUT } from '../data/pages/about';
import { photoSrcset } from '../lib/photo';
import { BRAND_MARK_PATH } from '../lib/brand-mark-path';
---

<Base
  title="About Integrant — Orthopaedic med-tech, bio-tech and AI"
  ogImage="/og/about.png"
  description="Integrant is a Sydney-based orthopaedic med-tech, bio-tech and AI company — implant systems, biologics and clinical software under one roof."
>
  <SubpageHero
    title="About."
    kicker="Orthopaedic Med-Tech · Bio-Tech · AI"
    lede="A Sydney company building the instruments, biologics and software of orthopaedic care — as one system, not three products."
    crumbs={[{ label: 'Integrant', href: '/' }, { label: 'About' }]}
    docRef="Doc 04 — About"
    meta={[
      { label: 'Entity', value: 'Integrant Biotechnology Ltd' },
      { label: 'Founder', value: ABOUT.founder.name },
      { label: 'Headquarters', value: 'Sydney, Australia' },
    ]}
    seed={149}
    variant="organic"
    backdrop="/photo/sydney-day.jpg"
  />

  <!-- 01 · Thesis -->
  <section class="relative bg-raised text-ink">
    <NeuralField variant="organic" seed={151} />
    <span class="corner corner-br border-hairline-strong" aria-hidden="true"></span>
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="eyebrow" data-reveal>01 — Thesis</p>
      <h2 class="sweep display-1 mt-6 max-w-4xl text-ink" data-sweep>
        {ABOUT.thesis.headline}
      </h2>
      <p class="mt-8 max-w-2xl text-xl leading-relaxed text-ink-2" data-reveal>{ABOUT.thesis.body}</p>
    </div>
  </section>

  <!-- 02 · On the record — cleared claims + verified-gated slots -->
  <section class="relative bg-base text-ink">
    <NeuralField variant="imaging" seed={153} />
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="eyebrow" data-reveal>02 — On the record</p>
      <h2 class="display-1 mt-6" data-reveal>What we publish, we can substantiate.</h2>
      <TrustBand class="mt-14" />
    </div>
  </section>

  <!-- 03 · Founder -->
  <section class="relative bg-base text-ink">
    <NeuralField variant="edge" seed={157} />
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="eyebrow" data-reveal>03 — Founder</p>

      <div class="mt-10 grid gap-10 md:grid-cols-[340px_1fr] md:items-center" data-reveal>
        <!-- Portrait plate — 3:4, engraved-plate treatment. Falls back to the
             typographic monogram if the portrait path is ever cleared. -->
        <div class="relative flex aspect-[3/4] items-center justify-center overflow-hidden border border-hairline bg-raised">
          {
            ABOUT.founder.portrait ? (
              <img
                src={ABOUT.founder.portrait}
                srcset={photoSrcset(ABOUT.founder.portrait)}
                sizes="340px"
                alt={`${ABOUT.founder.name}, founder of Integrant`}
                width="680"
                height="907"
                loading="lazy"
                class="h-full w-full object-cover grayscale"
              />
            ) : (
              <span class="font-display text-[9rem] font-bold leading-none text-ink" aria-hidden="true">
                {ABOUT.founder.monogram}
              </span>
            )
          }
          <span class="corner corner-tl border-hairline-strong" aria-hidden="true"></span>
          <span class="corner corner-br border-hairline-strong" aria-hidden="true"></span>
        </div>

        <div class="flex flex-col justify-center">
          <h2 class="font-display text-5xl font-bold text-ink md:text-6xl">{ABOUT.founder.name}</h2>
          <p class="readout mt-4 text-ink-2">{ABOUT.founder.role} · Surgeon-led design</p>
          <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-2">
            {
              ABOUT.founder.bio ??
                'Integrant’s systems are specified, instrumented and refined under the direction of its founding surgeon — engineering decisions made against theatre reality, not around it.'
            }
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · The formula — dark restatement of the BIO+AI arc -->
  <section data-contrast class="relative overflow-hidden bg-base text-ink">
    <NeuralField variant="lattice" seed={163} />
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="eyebrow" data-reveal>04 — The formula</p>
      <h2 class="display-1 mt-6 max-w-3xl" data-reveal>
        Biology, engineered. Intelligence, applied.
      </h2>

      <!-- The convergence, drawn: BIO and AI stream into the mark itself,
           and leave as one line. After the draw completes, a light impulse
           runs the merged line (motion-gated, decorative). -->
      <svg viewBox="0 0 900 320" class="mt-16 w-full" fill="none" data-draw aria-hidden="true" data-reveal>
        <!-- source streams -->
        <path d="M 10 70 C 260 70, 330 160, 415 160" stroke="currentColor" stroke-width="1.5" class="text-ink-2"></path>
        <path d="M 10 250 C 260 250, 330 160, 415 160" stroke="currentColor" stroke-width="1.5" class="text-ink-2"></path>
        <!-- origin nodes -->
        <circle cx="10" cy="70" r="4" fill="currentColor" class="text-ink-2"></circle>
        <circle cx="10" cy="250" r="4" fill="currentColor" class="text-ink-2"></circle>
        <!-- the mark at the point of convergence -->
        <g transform="translate(423 128) scale(0.0417)" data-no-draw>
          <path d={BRAND_MARK_PATH} fill="currentColor" fill-rule="evenodd" class="text-ink"></path>
        </g>
        <!-- one platform out -->
        <path d="M 492 160 H 882" stroke="currentColor" stroke-width="2" class="text-ink"></path>
        <path d="M 492 160 H 882" stroke="currentColor" stroke-width="2" class="formula-pulse text-ink" data-no-draw></path>
        <circle cx="886" cy="160" r="5" fill="currentColor" class="text-ink"></circle>
        <!-- geometry-mounted labels -->
        <text x="10" y="44" fill="currentColor" class="text-ink formula-label">BIO</text>
        <text x="10" y="292" fill="currentColor" class="text-ink formula-label">AI</text>
        <text x="70" y="44" fill="currentColor" class="hidden text-ink-3 formula-sublabel md:block">— IMPLANTS &amp; BIOLOGICS</text>
        <text x="52" y="292" fill="currentColor" class="hidden text-ink-3 formula-sublabel md:block">— CLINICAL SOFTWARE</text>
        <text x="886" y="132" text-anchor="end" fill="currentColor" class="text-ink formula-label">ONE PLATFORM</text>
      </svg>

      <div class="mt-14" data-reveal>
        <a href="/innovation" class="cta-ghost">The innovation program →</a>
      </div>
    </div>
  </section>

  <!-- 04 · Careers -->
  <section id="careers" class="relative bg-raised text-ink">
    <NeuralField variant="edge" seed={167} />
    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:grid-cols-2 md:py-32">
      <div>
        <p class="eyebrow" data-reveal>05 — Careers</p>
        <h2 class="display-1 mt-6" data-reveal>
          {ABOUT.careers.heading}
        </h2>
      </div>
      <div class="md:pt-16">
        <p class="max-w-xl text-lg leading-relaxed text-ink-2" data-reveal>{ABOUT.careers.body}</p>
        <div class="mt-8" data-reveal>
          <a href={`mailto:${ABOUT.careers.email}`} class="cta-solid" data-magnetic data-event="Email Click" data-event-location="careers">{ABOUT.careers.email}</a>
        </div>
        <p class="readout mt-10 text-xs text-ink-2" data-reveal>
          {ABOUT.location.label} · {ABOUT.location.coordinates}
        </p>
      </div>
    </div>
  </section>

  {/* The old facts strip moved up into 02 — On the record (TrustBand), which
      derives the same figures from src/data/site-metrics.ts. */}
</Base>
