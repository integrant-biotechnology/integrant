---
import Base from '../../../layouts/Base.astro';
import { PRODUCTS, type Product } from '../../../data/products';
import NeuralField from '../../../components/ui/NeuralField.astro';
import ProductViewer from '../../../components/ui/ProductViewer.astro';
import ProductPlate from '../../../components/ui/ProductPlate.astro';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { line: product.line, slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const lineLabel = product.line === 'med-tech' ? 'Med-Tech' : 'Bio-Tech';
const related = PRODUCTS.filter((p) => p.line === product.line && p.slug !== product.slug).slice(0, 3);

// Continuous catalogue index — same numbering as /products and the homepage
const position = PRODUCTS.findIndex((p) => p.slug === product.slug);
const folio = `System ${String(position + 1).padStart(2, '0')} / ${PRODUCTS.length}`;
const pad = (i: number) => String(i + 1).padStart(2, '0');
// Pager wraps at the ends so the walk-through never dead-ends
const prev = PRODUCTS[(position - 1 + PRODUCTS.length) % PRODUCTS.length];
const next = PRODUCTS[(position + 1) % PRODUCTS.length];

// The hero rail already states the first three specs, so the engineering
// panel carries only what the rail does not: any further specs, what the
// system is designed for, and what a set contains. With nothing further to
// say, the panel is not rendered at all.
const HERO_SPECS = 3;
const moreSpecs = product.specs.slice(HERO_SPECS);
const hasPanel = moreSpecs.length > 0 || Boolean(product.applications) || Boolean(product.contents);
const specCols = moreSpecs.length <= 1 ? '' : moreSpecs.length === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';

// Minimal, claim-free structured data: name/brand/description only — no
// medical properties, offers or ratings (TGA posture carries into metadata).
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Products', item: 'https://integrant.com.au/products' },
      { '@type': 'ListItem', position: 2, name: lineLabel, item: `https://integrant.com.au/products#${product.line}` },
      { '@type': 'ListItem', position: 3, name: product.name },
    ],
  },
  {
    '@type': 'Product',
    name: product.name,
    brand: { '@type': 'Brand', name: 'Integrant' },
    description: product.summary.slice(0, 155),
    category: product.category,
  },
];
// Meta description: whole sentences up to ~155 characters, never cut mid-word.
const sentences = product.summary.match(/[^.!?]+[.!?]+/g) ?? [product.summary];
let metaDescription = '';
for (const sentence of sentences) {
  if (metaDescription && (metaDescription + sentence).length > 158) break;
  metaDescription += sentence;
}
metaDescription = metaDescription.trim();
if (metaDescription.length > 158) {
  metaDescription = metaDescription.slice(0, 155).replace(/\s+\S*$/, '') + '…';
}
---

<Base
  title={`${product.name} — ${product.category} — Integrant`}
  description={metaDescription}
  ogImage={`/og/product-${product.slug}.png`}
  jsonLd={jsonLd}
>
  <!-- Dark hero strip: product identity + engineering readout -->
  <section data-contrast class="relative overflow-hidden bg-base text-ink">
    <NeuralField variant="dense" seed={89} />
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(110% 120% at 78% -25%, rgb(255 255 255 / 0.15), transparent 62%);"
      aria-hidden="true"
    >
    </div>
    <span class="corner corner-tl border-hairline-strong" aria-hidden="true"></span>

    <div class="relative mx-auto max-w-6xl px-6 pb-16 pt-32 md:pb-20 md:pt-44">
      <!-- Ruled bar: breadcrumbs left, folio right -->
      <div class="flex items-baseline justify-between gap-6 border-b border-hairline pb-5">
        <nav aria-label="Breadcrumb">
          <ol class="readout flex flex-wrap items-center gap-2 text-xs text-ink-2">
            <li><a href="/products" class="tap-target-sm inline-block transition-colors hover:text-ink">Products</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={`/products#${product.line}`} class="tap-target-sm inline-block transition-colors hover:text-ink">{lineLabel}</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-ink-2" aria-current="page">{product.name}</li>
          </ol>
        </nav>
        <p class="readout shrink-0 text-xs text-platinum md:text-sm">{folio}</p>
      </div>

      <div class="mt-10 grid gap-12 md:mt-14 md:grid-cols-[minmax(0,7fr)_minmax(300px,5fr)] md:gap-16">
        <div>
          <p class="eyebrow">{product.category}</p>
          <h1 class="display-hero mt-5 max-w-[14ch]">{product.name}</h1>
          <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-2 md:text-xl">{product.tagline}</p>
        </div>

        {
          /* Real first-party photography → interactive view cycling; otherwise
             the engineering specification plate — every system has a defined
             premium visual, on every viewport */
          product.views && product.views.length > 0 ? (
            <div class="self-center">
              <ProductViewer name={product.name} views={product.views} />
            </div>
          ) : (
            <ProductPlate product={product} mode="hero" class="self-center w-full max-h-[26rem]" />
          )
        }
      </div>

      <!-- The spec rail: the label's first line, Apple tech-specs voice -->
      <dl class="mt-14 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-hairline pt-6 md:mt-20 md:grid-cols-4">
        <div>
          <dt class="readout text-xs text-ink-2">Division</dt>
          <dd class="mt-1.5 font-display text-body font-semibold text-ink">{lineLabel}</dd>
        </div>
        {
          product.specs.slice(0, HERO_SPECS).map((spec) => (
            <div>
              <dt class="readout text-xs text-ink-2">{spec.label}</dt>
              <dd class="mt-1.5 font-display text-body font-semibold text-ink">{spec.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Overview + design features -->
  <section class="relative bg-raised text-ink">
    <NeuralField variant="organic" seed={97} />
    <div class="mx-auto grid max-w-6xl gap-14 px-6 py-16 md:grid-cols-2 md:py-32">
      <div>
        <p class="eyebrow" data-reveal>01 — Overview</p>
        <h2 class="display-2 mt-5" data-reveal>The system.</h2>
        <p class="mt-8 text-xl leading-relaxed text-ink-2 md:text-2xl md:leading-relaxed" data-reveal>
          {product.summary}
        </p>
      </div>

      {
        product.features.length > 0 && (
          <div data-reveal>
            <p class="eyebrow">02 — Design features</p>
            <h2 class="display-2 mt-5">Engineered in.</h2>
            <ol class="mt-8">
              {product.features.map((feature, i) => (
                <li class="flex gap-5 border-b border-hairline py-4 text-ink-2 first:border-t">
                  <span class="readout mt-1 text-xs tabular-nums text-platinum" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-body leading-relaxed">{feature}</span>
                </li>
              ))}
            </ol>
          </div>
        )
      }
    </div>
  </section>

  <!-- Engineering panel: further specs + applications + contents -->
  {
    hasPanel && (
  <section class="relative bg-base text-ink">
    <NeuralField variant="lattice" seed={101} />
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="eyebrow" data-reveal>03 — Specification</p>
      <h2 class="display-2 mt-5" data-reveal>In detail.</h2>

      {/* Bordered cells rather than a gap-background grid: the column
          count adapts to how many specs remain, so no orphan cells */}
      {moreSpecs.length > 0 && (
      <div class={`mt-10 grid gap-4 ${specCols}`} data-reveal>
        {
          moreSpecs.map((spec, i) => (
            <div class="relative border border-hairline bg-base p-6">
              {i === 0 && <span class="corner corner-tl border-hairline-strong" aria-hidden="true" />}
              <p class="readout text-xs text-ink-2">{spec.label}</p>
              <p class="mt-3 font-display text-2xl font-bold leading-snug tabular-nums text-ink md:text-3xl">
                {spec.value}
              </p>
            </div>
          ))
        }
      </div>
      )}

      {
        (product.applications || product.contents) && (
          <div class:list={['grid gap-14 md:grid-cols-2', moreSpecs.length > 0 ? 'mt-16' : 'mt-10']}>
            {product.applications && (
              <div data-reveal>
                <p class="eyebrow">Designed for</p>
                <ul class="mt-6 space-y-3">
                  {product.applications.map((application) => (
                    <li class="border-b border-hairline pb-3 text-body text-ink-2">{application}</li>
                  ))}
                </ul>
              </div>
            )}
            {product.contents && (
              <div data-reveal>
                <p class="eyebrow">{product.slug === 'screw-removal-set' ? 'Removes' : 'Set contents'}</p>
                <ul class="mt-6 space-y-3">
                  {product.contents.map((item) => (
                    <li class="border-b border-hairline pb-3 text-body text-ink-2">{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )
      }
    </div>
  </section>
    )
  }

  <!-- Catalogue tables — engineering-drawing treatment -->
  {
    product.tables && product.tables.length > 0 && (
      <section class="relative bg-raised text-ink">
        <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
          <p class="eyebrow" data-reveal>04 — Catalogue</p>
          <h2 class="display-2 mt-5" data-reveal>Reference numbers.</h2>

          <div class="mt-10 space-y-14">
            {product.tables.map((table) => (
              <div data-reveal>
                {table.caption && (
                  <div class="flex items-baseline justify-between gap-6">
                    <h3 class="font-display text-2xl font-semibold text-ink">{table.caption}</h3>
                    <p class="readout text-xs text-ink-2">
                      {table.rows.length} reference{table.rows.length === 1 ? '' : 's'}
                    </p>
                  </div>
                )}
                <!-- Scrollable regions need to be reachable by keyboard, and
                     need to *look* scrollable — hence tabindex + edge fade -->
                <div
                  class="table-scroll mt-6 overflow-x-auto border border-hairline bg-base"
                  tabindex="0"
                  role="region"
                  aria-label={`${product.name} ${table.caption ?? 'catalogue'} — scrollable table`}
                >
                  <table class="w-full min-w-[32rem] border-collapse text-left">
                    <thead>
                      <tr class="border-b border-hairline">
                        {table.columns.map((column) => (
                          <th scope="col" class="readout px-6 py-4 text-xs font-medium text-ink-2">
                            {column}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {table.rows.map((row) => (
                        <tr class="border-b border-hairline transition-colors duration-200 last:border-0 hover:bg-inset">
                          {row.map((cell, cellIndex) => (
                            <td
                              class={
                                cellIndex === 0
                                  ? 'px-6 py-4 font-display text-body font-semibold tabular-nums text-ink'
                                  : 'px-6 py-4 text-sm text-ink-2'
                              }
                            >
                              {cell}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Enquiry + regulatory note -->
  <section data-contrast class="relative bg-base text-ink">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-28">
      <p class="readout text-xs text-ink-2" data-reveal>
        {product.name} · Supplied on enquiry · AU / NZ
      </p>
      <div class="mt-8 grid gap-12 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <h2 class="display-1" data-reveal>
            Enquire about {product.name}.
          </h2>
          <p class="mt-6 max-w-xl text-lg text-ink-2" data-reveal>
            Supplied to healthcare professionals across Australia and New
            Zealand. Our team can provide specifications, instrumentation
            detail and availability.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4" data-reveal>
          <a
            href="mailto:admin@integrant.com.au"
            class="cta-solid"
            data-magnetic
            data-event="Email Click"
            data-event-location="product"
            data-event-product={product.slug}
          >
            Request information
          </a>
          <a href="/for-surgeons" class="cta-ghost">How surgeons work with us →</a>
        </div>
      </div>

      <p class="mt-16 max-w-3xl border-t border-hairline pt-8 text-sm leading-relaxed text-ink-3">
        Specifications and catalogue references are provided for product
        identification and are subject to confirmation. Refer to the
        Instructions for Use supplied with each device for indications,
        contraindications and warnings.
      </p>
    </div>
  </section>

  <!-- Related systems -->
  {
    related.length > 0 && (
      <section class="relative bg-raised text-ink">
        <div class="mx-auto max-w-6xl px-6 py-16 md:py-28">
          <h2 class="eyebrow" data-reveal>Related systems</h2>
          <div class="mt-10 grid gap-6 sm:grid-cols-3">
            {related.map((item) => (
              <a
                href={`/products/${item.line}/${item.slug}`}
                class="group flex flex-col border border-hairline bg-raised transition-colors duration-300 hover:border-hairline-strong hover:bg-base"
                data-reveal
              >
                {item.views && item.views.length > 0 ? (
                  <span
                    class="relative block h-40 border-b border-hairline specimen"
                    aria-hidden="true"
                  >
                    <img
                      src={item.views[0].small ?? item.views[0].src}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-contain p-4"
                    />
                  </span>
                ) : (
                  <span class="flex h-40 items-center justify-center border-b border-hairline bg-inset" aria-hidden="true">
                    <ProductPlate product={item} mode="thumb" class="h-32 w-32 border-0 bg-transparent" />
                  </span>
                )}
                <span class="flex flex-1 flex-col justify-between p-7">
                  <span>
                    <span class="readout block text-xs text-ink-2">{item.category}</span>
                    <span class="mt-4 block font-display text-2xl font-bold text-ink">{item.name}</span>
                  </span>
                  <span class="readout mt-8 block text-xs text-ink-2 transition-colors duration-300 group-hover:text-ink">
                    View system →
                  </span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- The walk-through: prev / next along the catalogue index -->
  <nav aria-label="Catalogue walk-through" class="relative bg-base text-ink">
    <div class="mx-auto grid max-w-6xl grid-cols-2 border-t border-hairline">
      <a
        href={`/products/${prev.line}/${prev.slug}`}
        class="group flex min-h-28 flex-col justify-center gap-2 border-r border-hairline py-8 pr-6 transition-colors duration-300 hover:bg-raised md:py-10"
      >
        <span class="readout text-xs text-ink-2">← {pad((position - 1 + PRODUCTS.length) % PRODUCTS.length)}</span>
        <span class="font-display text-2xl font-bold text-ink-2 transition-colors duration-300 group-hover:text-ink md:text-3xl">
          {prev.name}
        </span>
      </a>
      <a
        href={`/products/${next.line}/${next.slug}`}
        class="group flex min-h-28 flex-col items-end justify-center gap-2 py-8 pl-6 text-right transition-colors duration-300 hover:bg-raised md:py-10"
      >
        <span class="readout text-xs text-ink-2">{pad((position + 1) % PRODUCTS.length)} →</span>
        <span class="font-display text-2xl font-bold text-ink-2 transition-colors duration-300 group-hover:text-ink md:text-3xl">
          {next.name}
        </span>
      </a>
    </div>
  </nav>
</Base>
