---
import Base from '../../../layouts/Base.astro';
import { PRODUCTS, type Product } from '../../../data/products';
import NeuralField from '../../../components/ui/NeuralField.astro';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { line: product.line, slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const lineLabel = product.line === 'med-tech' ? 'Med-Tech' : 'Bio-Tech';
const related = PRODUCTS.filter((p) => p.line === product.line && p.slug !== product.slug).slice(0, 3);

// Minimal, claim-free structured data: name/brand/description only — no
// medical properties, offers or ratings (TGA posture carries into metadata).
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Products', item: 'https://integrant.com.au/products' },
      { '@type': 'ListItem', position: 2, name: lineLabel, item: `https://integrant.com.au/products#${product.line}` },
      { '@type': 'ListItem', position: 3, name: product.name },
    ],
  },
  {
    '@type': 'Product',
    name: product.name,
    brand: { '@type': 'Brand', name: 'Integrant' },
    description: product.summary.slice(0, 155),
    category: product.category,
  },
];
---

<Base
  title={`${product.name} — ${product.category} | Integrant`}
  description={product.summary.slice(0, 155)}
  ogImage={`/og/product-${product.slug}.png`}
  jsonLd={jsonLd}
>
  <!-- Dark hero strip: product identity + engineering readout -->
  <section data-contrast class="relative overflow-hidden bg-base text-ink">
    <NeuralField variant="dense" seed={89} />
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(110% 120% at 78% -25%, rgb(255 255 255 / 0.15), transparent 62%);"
      aria-hidden="true"
    >
    </div>
    <span class="corner corner-tl border-hairline-strong" aria-hidden="true"></span>

    <div class="relative mx-auto grid max-w-6xl gap-12 px-6 pb-20 pt-36 md:grid-cols-[1fr_320px] md:pb-24 md:pt-44">
      <div>
        <nav aria-label="Breadcrumb">
          <ol class="readout flex flex-wrap items-center gap-2 text-xs text-ink-3">
            <li><a href="/products" class="tap-target-sm inline-block transition-colors hover:text-ink">Products</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={`/products#${product.line}`} class="tap-target-sm inline-block transition-colors hover:text-ink">{lineLabel}</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-ink-2" aria-current="page">{product.name}</li>
          </ol>
        </nav>

        <h1
          class="mt-8 max-w-[14ch] font-display text-5xl font-bold leading-[0.98] [text-wrap:balance] sm:text-6xl md:text-7xl xl:text-8xl"
        >{product.name}</h1>
        <p class="mt-5 text-xl text-ink-2 md:text-2xl">{product.category}</p>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-2">{product.tagline}</p>

        <div class="mt-10 flex flex-wrap gap-3">
          <span class="readout border border-hairline-strong px-4 py-2.5 text-xs text-ink-2">{lineLabel}</span>
          {
            product.specs.slice(0, 2).map((spec) => (
              <span class="readout border border-hairline-strong px-4 py-2.5 text-xs text-ink-2">{spec.value}</span>
            ))
          }
        </div>
      </div>

      <!-- Product visual well — photography/render pending (see CLAUDE.md gap list) -->
      <div class="relative hidden aspect-square border border-hairline md:block" aria-hidden="true">
        <span
          class="absolute left-1/2 top-1/2 block h-40 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full"
          style="background: linear-gradient(180deg, #e6e6e6, #2a2a2a); transform: translate(-50%, -50%) rotate(16deg);"
        ></span>
        <span class="corner corner-br border-hairline-strong"></span>
      </div>
    </div>
  </section>

  <!-- Overview + design features -->
  <section class="relative bg-raised text-ink">
    <NeuralField variant="organic" seed={97} />
    <div class="mx-auto grid max-w-6xl gap-14 px-6 py-16 md:grid-cols-2 md:py-32">
      <div>
        <p class="readout md:text-sm text-ink-2" data-reveal>01 — Overview</p>
        <h2 class="mt-5 font-display text-3xl font-bold leading-tight md:text-4xl" data-reveal>The system.</h2>
        <p class="mt-8 text-lg leading-relaxed text-ink-2" data-reveal>{product.summary}</p>
      </div>

      {
        product.features.length > 0 && (
          <div data-reveal>
            <p class="readout md:text-sm text-ink-2">02 — Design features</p>
            <h2 class="mt-5 font-display text-3xl font-bold leading-tight md:text-4xl">Engineered in.</h2>
            <ul class="mt-8 space-y-4">
              {product.features.map((feature) => (
                <li class="flex gap-4 border-b border-hairline pb-4 text-ink-2">
                  <span class="readout mt-1 text-xs text-ink-3" aria-hidden="true">—</span>
                  <span class="leading-relaxed">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <!-- Engineering panel: specs + applications + contents -->
  <section class="relative bg-base text-ink">
    <NeuralField variant="lattice" seed={101} />
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="readout md:text-sm text-ink-2" data-reveal>03 — Specification</p>
      <h2 class="mt-5 font-display text-3xl font-bold leading-tight md:text-4xl" data-reveal>On the label.</h2>

      <!-- Bordered cells rather than a gap-background grid: spec counts vary
           per product (2–4), so empty cells must not render as grey blocks -->
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
        {
          product.specs.map((spec) => (
            <div class="border border-hairline bg-base p-6">
              <p class="readout text-xs text-ink-3">{spec.label}</p>
              <p class="mt-3 font-display text-xl font-semibold leading-snug text-ink">{spec.value}</p>
            </div>
          ))
        }
      </div>

      {
        (product.applications || product.contents) && (
          <div class="mt-16 grid gap-14 md:grid-cols-2">
            {product.applications && (
              <div data-reveal>
                <p class="readout md:text-sm text-ink-2">Designed for</p>
                <ul class="mt-6 space-y-3">
                  {product.applications.map((application) => (
                    <li class="text-ink-2">{application}</li>
                  ))}
                </ul>
              </div>
            )}
            {product.contents && (
              <div data-reveal>
                <p class="readout md:text-sm text-ink-2">{product.slug === 'screw-removal-set' ? 'Removes' : 'Set contents'}</p>
                <ul class="mt-6 space-y-3">
                  {product.contents.map((item) => (
                    <li class="text-ink-2">{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )
      }
    </div>
  </section>

  <!-- Catalogue tables — engineering-drawing treatment -->
  {
    product.tables && product.tables.length > 0 && (
      <section class="relative bg-raised text-ink">
        <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
          <p class="readout md:text-sm text-ink-2" data-reveal>04 — Catalogue</p>
          <h2 class="mt-5 font-display text-3xl font-bold leading-tight md:text-4xl" data-reveal>Reference numbers.</h2>

          <div class="mt-10 space-y-14">
            {product.tables.map((table) => (
              <div data-reveal>
                {table.caption && (
                  <h3 class="font-display text-2xl font-semibold text-ink">{table.caption}</h3>
                )}
                <!-- Scrollable regions need to be reachable by keyboard, and
                     need to *look* scrollable — hence tabindex + edge fade -->
                <div
                  class="table-scroll mt-6 overflow-x-auto border border-hairline bg-base"
                  tabindex="0"
                  role="region"
                  aria-label={`${product.name} ${table.caption ?? 'catalogue'} — scrollable table`}
                >
                  <table class="w-full min-w-[32rem] border-collapse text-left">
                    <thead>
                      <tr class="border-b border-hairline">
                        {table.columns.map((column) => (
                          <th scope="col" class="readout px-6 py-4 text-xs font-medium text-ink-3">
                            {column}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {table.rows.map((row) => (
                        <tr class="border-b border-hairline last:border-0">
                          {row.map((cell, cellIndex) => (
                            <td
                              class={
                                cellIndex === 0
                                  ? 'px-6 py-4 font-display text-base font-semibold tabular-nums text-ink'
                                  : 'px-6 py-4 text-sm text-ink-2'
                              }
                            >
                              {cell}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Enquiry + regulatory note -->
  <section data-contrast class="relative bg-base text-ink">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-28">
      <div class="grid gap-12 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <h2 class="font-display text-3xl font-bold leading-tight md:text-5xl" data-reveal>
            Enquire about {product.name}.
          </h2>
          <p class="mt-6 max-w-xl text-lg text-ink-2" data-reveal>
            Supplied to healthcare professionals across Australia and New
            Zealand. Our team can provide specifications, instrumentation
            detail and availability.
          </p>
        </div>
        <div data-reveal>
          <a href="mailto:admin@integrant.com.au" class="cta-solid" data-magnetic>Request information</a>
        </div>
      </div>

      <p class="mt-16 max-w-3xl border-t border-hairline pt-8 text-sm leading-relaxed text-ink-3">
        Specifications and catalogue references are provided for product
        identification and are subject to confirmation. Refer to the
        Instructions for Use supplied with each device for indications,
        contraindications and warnings.
      </p>
    </div>
  </section>

  <!-- Related systems -->
  {
    related.length > 0 && (
      <section class="relative bg-raised text-ink">
        <div class="mx-auto max-w-6xl px-6 py-24">
          <p class="readout md:text-sm text-ink-2" data-reveal>Related systems</p>
          <div class="mt-10 grid gap-6 sm:grid-cols-3">
            {related.map((item) => (
              <a
                href={`/products/${item.line}/${item.slug}`}
                class="group border border-hairline bg-raised p-7 transition-colors duration-300 hover:border-hairline-strong hover:bg-base"
                data-reveal
              >
                <p class="readout text-xs text-ink-3">{item.category}</p>
                <h3 class="mt-4 font-display text-2xl font-bold text-ink">{item.name}</h3>
                <p class="readout mt-8 text-xs text-ink-3 transition-colors duration-300 group-hover:text-ink">
                  View system →
                </p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
