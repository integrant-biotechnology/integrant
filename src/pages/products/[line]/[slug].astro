---
import Base from '../../../layouts/Base.astro';
import { PRODUCTS, type Product } from '../../../data/products';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { line: product.line, slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const lineLabel = product.line === 'med-tech' ? 'Med-Tech' : 'Bio-Tech';
const related = PRODUCTS.filter((p) => p.line === product.line && p.slug !== product.slug).slice(0, 3);
---

<Base
  title={`${product.name} — ${product.category} | Integrant`}
  description={product.summary.slice(0, 155)}
>
  <!-- Dark hero strip: product identity + engineering readout -->
  <section class="relative overflow-hidden bg-void text-white">
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(110% 120% at 78% -25%, rgb(255 255 255 / 0.15), transparent 62%);"
      aria-hidden="true"
    >
    </div>
    <span class="corner corner-tl border-white/20" aria-hidden="true"></span>

    <div class="relative mx-auto grid max-w-6xl gap-12 px-6 pb-20 pt-36 md:grid-cols-[1fr_320px] md:pb-24 md:pt-44">
      <div>
        <nav aria-label="Breadcrumb">
          <ol class="readout flex flex-wrap items-center gap-2 text-[10px] text-white/40">
            <li><a href="/products" class="transition-colors hover:text-white">Products</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={`/products#${product.line}`} class="transition-colors hover:text-white">{lineLabel}</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-white/70" aria-current="page">{product.name}</li>
          </ol>
        </nav>

        <h1 class="mt-8 font-display text-6xl font-bold leading-[0.98] md:text-8xl">{product.name}</h1>
        <p class="mt-5 text-xl text-white/65 md:text-2xl">{product.category}</p>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-white/55">{product.tagline}</p>

        <div class="mt-10 flex flex-wrap gap-3">
          <span class="readout border border-white/20 px-4 py-2.5 text-[10px] text-white/70">{lineLabel}</span>
          {
            product.specs.slice(0, 2).map((spec) => (
              <span class="readout border border-white/20 px-4 py-2.5 text-[10px] text-white/70">{spec.value}</span>
            ))
          }
        </div>
      </div>

      <!-- Product visual well — photography/render pending (see CLAUDE.md gap list) -->
      <div class="relative hidden aspect-square border border-white/10 md:block" aria-hidden="true">
        <span
          class="absolute left-1/2 top-1/2 block h-40 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full"
          style="background: linear-gradient(180deg, #e6e6e6, #2a2a2a); transform: translate(-50%, -50%) rotate(16deg);"
        ></span>
        <span class="corner corner-br border-white/20"></span>
      </div>
    </div>
  </section>

  <!-- Overview + design features -->
  <section class="relative bg-surface text-ink" data-nav-theme="light">
    <div class="mx-auto grid max-w-6xl gap-14 px-6 py-24 md:grid-cols-2 md:py-32">
      <div>
        <p class="readout text-ink/45" data-reveal>01 — Overview</p>
        <p class="mt-8 text-lg leading-relaxed text-ink/75" data-reveal>{product.summary}</p>
      </div>

      {
        product.features.length > 0 && (
          <div data-reveal>
            <p class="readout text-ink/45">02 — Design features</p>
            <ul class="mt-8 space-y-4">
              {product.features.map((feature) => (
                <li class="flex gap-4 border-b border-ink/10 pb-4 text-ink/75">
                  <span class="readout mt-1 text-[10px] text-ink/30" aria-hidden="true">—</span>
                  <span class="leading-relaxed">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <!-- Engineering panel: specs + applications + contents -->
  <section class="relative bg-white text-ink" data-nav-theme="light">
    <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
      <p class="readout text-ink/45" data-reveal>03 — Specification</p>

      <!-- Bordered cells rather than a gap-background grid: spec counts vary
           per product (2–4), so empty cells must not render as grey blocks -->
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
        {
          product.specs.map((spec) => (
            <div class="border border-ink/12 bg-white p-6">
              <p class="readout text-[10px] text-ink/40">{spec.label}</p>
              <p class="mt-3 font-display text-xl font-semibold leading-snug text-ink">{spec.value}</p>
            </div>
          ))
        }
      </div>

      {
        (product.applications || product.contents) && (
          <div class="mt-16 grid gap-14 md:grid-cols-2">
            {product.applications && (
              <div data-reveal>
                <p class="readout text-ink/45">Designed for</p>
                <ul class="mt-6 space-y-3">
                  {product.applications.map((application) => (
                    <li class="text-ink/70">{application}</li>
                  ))}
                </ul>
              </div>
            )}
            {product.contents && (
              <div data-reveal>
                <p class="readout text-ink/45">{product.slug === 'screw-removal-set' ? 'Removes' : 'Set contents'}</p>
                <ul class="mt-6 space-y-3">
                  {product.contents.map((item) => (
                    <li class="text-ink/70">{item}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )
      }
    </div>
  </section>

  <!-- Catalogue tables — engineering-drawing treatment -->
  {
    product.tables && product.tables.length > 0 && (
      <section class="relative bg-surface text-ink" data-nav-theme="light">
        <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
          <p class="readout text-ink/45" data-reveal>04 — Catalogue</p>

          <div class="mt-10 space-y-14">
            {product.tables.map((table) => (
              <div data-reveal>
                {table.caption && (
                  <h3 class="font-display text-2xl font-semibold text-ink">{table.caption}</h3>
                )}
                <!-- Scrollable regions need to be reachable by keyboard, and
                     need to *look* scrollable — hence tabindex + edge fade -->
                <div
                  class="table-scroll mt-6 overflow-x-auto border border-ink/12 bg-white"
                  tabindex="0"
                  role="region"
                  aria-label={`${product.name} ${table.caption ?? 'catalogue'} — scrollable table`}
                >
                  <table class="w-full min-w-[32rem] border-collapse text-left">
                    <thead>
                      <tr class="border-b border-ink/12">
                        {table.columns.map((column) => (
                          <th scope="col" class="readout px-6 py-4 text-[10px] font-medium text-ink/45">
                            {column}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {table.rows.map((row) => (
                        <tr class="border-b border-ink/8 last:border-0">
                          {row.map((cell, cellIndex) => (
                            <td
                              class={
                                cellIndex === 0
                                  ? 'px-6 py-4 font-display text-base font-semibold tabular-nums text-ink'
                                  : 'px-6 py-4 text-sm text-ink/70'
                              }
                            >
                              {cell}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Enquiry + regulatory note -->
  <section class="relative bg-canvas text-white">
    <div class="mx-auto max-w-6xl px-6 py-24 md:py-28">
      <div class="grid gap-12 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <h2 class="font-display text-3xl font-bold leading-tight md:text-5xl" data-reveal>
            Enquire about {product.name}.
          </h2>
          <p class="mt-6 max-w-xl text-lg text-white/55" data-reveal>
            Supplied to healthcare professionals across Australia and New
            Zealand. Our team can provide specifications, instrumentation
            detail and availability.
          </p>
        </div>
        <div data-reveal>
          <a href="mailto:admin@integrant.com.au" class="cta-solid" data-magnetic>Request information</a>
        </div>
      </div>

      <p class="mt-16 max-w-3xl border-t border-white/10 pt-8 text-sm leading-relaxed text-white/40">
        Specifications and catalogue references are provided for product
        identification and are subject to confirmation. Refer to the
        Instructions for Use supplied with each device for indications,
        contraindications and warnings.
      </p>
    </div>
  </section>

  <!-- Related systems -->
  {
    related.length > 0 && (
      <section class="relative bg-surface text-ink" data-nav-theme="light">
        <div class="mx-auto max-w-6xl px-6 py-24">
          <p class="readout text-ink/45" data-reveal>Related systems</p>
          <div class="mt-10 grid gap-6 sm:grid-cols-3">
            {related.map((item) => (
              <a
                href={`/products/${item.line}/${item.slug}`}
                class="group border border-ink/12 bg-surface p-7 transition-colors duration-300 hover:border-ink/30 hover:bg-white"
                data-reveal
              >
                <p class="readout text-[10px] text-ink/40">{item.category}</p>
                <h3 class="mt-4 font-display text-2xl font-bold text-ink">{item.name}</h3>
                <p class="readout mt-8 text-[10px] text-ink/40 transition-colors duration-300 group-hover:text-ink">
                  View system →
                </p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
