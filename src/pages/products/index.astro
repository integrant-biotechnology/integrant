---
import Base from '../../layouts/Base.astro';
import { PRODUCTS, PRODUCT_LINES } from '../../data/products';
import NeuralField from '../../components/ui/NeuralField.astro';

const title = 'Product systems — Integrant';
const description =
  'Integrant implant systems, instrumentation and graft materials — engineered for foot, ankle, hand and wrist.';
---

<Base title={title} description={description} ogImage="/og/products.png">
  <!-- Dark bookend: keeps the fixed nav legible and anchors the catalogue -->
  <section data-contrast class="relative overflow-hidden bg-base text-ink">
    <!-- Material ambience: spun-metal macro under the scrim (photography.ts) -->
    <img
      src="/photo/metal.jpg"
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="low"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover grayscale"
    />
    <div
      class="absolute inset-0"
      style="background: linear-gradient(100deg, rgb(0 0 0 / 0.88) 0%, rgb(0 0 0 / 0.72) 55%, rgb(0 0 0 / 0.62) 100%);"
      aria-hidden="true"
    >
    </div>
    <NeuralField variant="dense" seed={83} />
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(120% 90% at 12% -20%, rgb(255 255 255 / 0.16), transparent 60%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-6 pb-24 pt-40 md:pb-28 md:pt-48">
      <p class="readout md:text-sm text-ink-2">Catalogue</p>
      <h1 class="mt-6 max-w-3xl font-display text-4xl font-bold leading-[1.03] [text-wrap:balance] sm:text-5xl md:text-6xl xl:text-7xl">
        Precision, instrument by instrument.
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-2">
        Two divisions, one engineering standard — implant systems and
        instrumentation for the foot and ankle, and graft materials that work
        with the body’s own repair.
      </p>
    </div>
  </section>

  {
    PRODUCT_LINES.map((line, lineIndex) => (
      <section
        id={line.id}
        class={lineIndex % 2 === 0 ? 'relative bg-raised text-ink' : 'relative bg-base text-ink'}
      >
        <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
          <p class="readout md:text-sm text-ink-2" data-reveal>
            {String(lineIndex + 1).padStart(2, '0')} — {line.label}
          </p>
          <h2 class="sweep mt-6 max-w-2xl font-display text-4xl font-bold leading-tight md:text-5xl lg:text-6xl" data-sweep>
            {line.blurb}
          </h2>

          <!-- Individually bordered cards: an odd item count must never leave
               empty cells showing the grid's hairline background -->
          <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {PRODUCTS.filter((p) => p.line === line.id).map((product) => (
              <a
                href={`/products/${product.line}/${product.slug}`}
                class="group relative flex min-h-64 flex-col justify-between border border-hairline bg-raised p-7 transition-colors duration-300 hover:border-hairline-strong hover:bg-base"
                data-reveal
              >
                <div>
                  <div class="flex items-start justify-between gap-4">
                    <p class="readout text-xs text-ink-3">{product.category}</p>
                    {/* real photography exists — small specimen thumbnail */}
                    {product.views && product.views.length > 0 && (
                      <span
                        class="block h-16 w-16 shrink-0 border border-hairline"
                        style="background: linear-gradient(155deg, #f2f2f2, #d4d4d4);"
                        aria-hidden="true"
                      >
                        <img
                          src={product.views[0].small ?? product.views[0].src}
                          alt=""
                          width="1400"
                          height="1400"
                          loading="lazy"
                          class="h-full w-full object-contain p-1.5"
                        />
                      </span>
                    )}
                  </div>
                  <h3 class="mt-4 font-display text-3xl font-bold text-ink">{product.name}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-ink-2">{product.tagline}</p>
                </div>
                <p class="readout mt-8 text-xs text-ink-3 transition-colors duration-300 group-hover:text-ink">
                  View system →
                </p>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="relative bg-raised text-ink">
    <div class="mx-auto max-w-6xl border-t border-hairline px-6 py-16">
      <p class="max-w-3xl text-sm leading-relaxed text-ink-3">
        Implant systems are supplied to healthcare professionals on enquiry.
        Product specifications are provided for identification and are subject
        to confirmation; refer to the Instructions for Use supplied with each
        device for indications, contraindications and warnings.
      </p>
    </div>
  </section>
</Base>
