---
import Base from '../../layouts/Base.astro';
import { PRODUCTS, PRODUCT_LINES } from '../../data/products';
import NeuralField from '../../components/ui/NeuralField.astro';
import ProductPlate from '../../components/ui/ProductPlate.astro';
import { ANATOMY_AREAS } from '../../data/anatomy-areas';

const title = 'Product systems — Integrant';
const description =
  'Integrant implant systems, instrumentation and graft materials — engineered for foot, ankle, hand and wrist.';

// Continuous catalogue index 01–12 — the same number the homepage showcase
// and the detail-page pager use, tied to the product-systems metric.
const indexOf = (slug: string) =>
  String(PRODUCTS.findIndex((p) => p.slug === slug) + 1).padStart(2, '0');

// Anatomy filter (?region=<slug>, linked from the For surgeons index): each
// card carries the regions its system is mapped to in anatomy-areas.ts.
const regionsOf = (slug: string) =>
  ANATOMY_AREAS.filter((a) => a.productSlugs.includes(slug))
    .map((a) => a.slug)
    .join(' ');
const REGION_NAMES = Object.fromEntries(
  ANATOMY_AREAS.filter((a) => a.productSlugs.length > 0).map((a) => [a.slug, a.name]),
);

// Each line leads with its flagship as a full-width feature row
const LEAD: Record<string, string> = { 'med-tech': 'archit', 'bio-tech': 'frameit' };

const specLine = (p: (typeof PRODUCTS)[number]) =>
  p.specs
    .slice(0, 2)
    .map((s) => s.value)
    .join(' · ');
---

<Base title={title} description={description} ogImage="/og/products.png">
  <!-- Dark bookend: keeps the fixed nav legible and anchors the catalogue -->
  <section data-contrast class="relative overflow-hidden bg-base text-ink">
    <!-- Material ambience: spun-metal macro under the scrim (photography.ts) -->
    <img
      src="/photo/metal.jpg"
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="low"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover grayscale"
      data-parallax="0.08"
    />
    <div
      class="absolute inset-0"
      style="background: linear-gradient(100deg, rgb(0 0 0 / 0.88) 0%, rgb(0 0 0 / 0.72) 55%, rgb(0 0 0 / 0.62) 100%);"
      aria-hidden="true"
    >
    </div>
    <NeuralField variant="dense" seed={83} />
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(120% 90% at 12% -20%, rgb(255 255 255 / 0.16), transparent 60%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-6 pb-20 pt-40 md:pb-24 md:pt-48">
      <p class="eyebrow">Catalogue</p>
      <h1 class="display-hero mt-6 max-w-4xl">Precision, instrument by instrument.</h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-2 md:text-xl">
        Two divisions, one engineering standard — implant systems and
        instrumentation for the foot and ankle, and graft materials that work
        with the body’s own repair.
      </p>

      <!-- Division index: jump links, counted from the catalogue itself -->
      <div class="mt-12 grid gap-px border border-hairline bg-hairline sm:grid-cols-2">
        {
          PRODUCT_LINES.map((line, lineIndex) => (
            <a
              href={`#${line.id}`}
              class="group flex items-baseline justify-between gap-6 bg-raised p-6 transition-colors duration-300 hover:bg-inset"
            >
              <span class="flex items-baseline gap-4">
                <span class="font-display text-lg font-bold tabular-nums text-platinum">
                  {String(lineIndex + 1).padStart(2, '0')}
                </span>
                <span class="readout text-xs text-ink md:text-sm">{line.label}</span>
              </span>
              <span class="readout text-xs text-ink-2 transition-colors duration-300 group-hover:text-ink">
                <span data-count={PRODUCTS.filter((p) => p.line === line.id).length}>
                  {PRODUCTS.filter((p) => p.line === line.id).length}
                </span>{' '}
                systems ↓
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Region filter status: revealed by the script below only when the URL
       carries a known ?region= value -->
  <div id="region-filter" class="relative bg-raised text-ink" data-regions-map={JSON.stringify(REGION_NAMES)} hidden>
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 border-b border-hairline px-6 py-6">
      <p class="readout text-xs text-ink" role="status" data-region-label></p>
      <a href="/products" class="cta-ghost">Show all systems →</a>
    </div>
  </div>

  {
    PRODUCT_LINES.map((line, lineIndex) => {
      const lineProducts = PRODUCTS.filter((p) => p.line === line.id);
      const lead = lineProducts.find((p) => p.slug === LEAD[line.id]) ?? lineProducts[0];
      const rest = lineProducts.filter((p) => p !== lead);
      return (
        <section
          id={line.id}
          data-line-section
          class={lineIndex % 2 === 0 ? 'relative bg-raised text-ink' : 'relative bg-base text-ink'}
        >
          <NeuralField variant={lineIndex % 2 === 0 ? 'lattice' : 'imaging'} seed={83 + lineIndex * 6} />
          <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
            <p class="eyebrow" data-reveal>
              {String(lineIndex + 1).padStart(2, '0')} — {line.label} ·{' '}
              {lineProducts.length} systems
            </p>
            <h2 class="sweep display-1 mt-6 max-w-3xl" data-sweep>
              {line.blurb}
            </h2>

            <!-- The flagship: a full feature row -->
            <article class="group mt-14 grid items-center gap-8 md:grid-cols-[5fr_7fr] md:gap-14" data-catalogue-item data-regions={regionsOf(lead.slug)} data-reveal>
              <div>
                <p class="readout text-xs text-platinum">
                  {indexOf(lead.slug)} / {PRODUCTS.length} — {lead.category}
                </p>
                <h3 class="mt-4">
                  <a href={`/products/${lead.line}/${lead.slug}`} class="display-2 tap-target-sm text-ink">
                    {lead.name}
                  </a>
                </h3>
                <p class="mt-4 max-w-md text-lg leading-relaxed text-ink-2">{lead.tagline}</p>
                <p class="readout mt-6 text-xs text-ink-2">{specLine(lead)}</p>
                <p class="mt-8">
                  <a
                    href={`/products/${lead.line}/${lead.slug}`}
                    class="readout tap-target-sm text-xs text-ink-2 transition-colors duration-300 group-hover:text-ink"
                    data-event="View System"
                    data-event-product={lead.slug}
                    data-event-location="catalogue"
                  >
                    View system →
                  </a>
                </p>
              </div>
              <div>
                {lead.views?.length ? (
                  <figure class="relative overflow-hidden border border-hairline">
                    <span class="corner corner-tl border-hairline-strong" aria-hidden="true" />
                    <span class="corner corner-br border-hairline-strong" aria-hidden="true" />
                    <div class="relative aspect-[4/3] specimen">
                      <img
                        src={lead.views[0].small ?? lead.views[0].src}
                        alt={lead.views[0].alt}
                        class="absolute inset-0 h-full w-full object-contain p-8"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <figcaption class="flex items-center justify-between border-t border-hairline px-5 py-3">
                      <span class="readout text-xs text-ink-2">Specimen — first-party capture</span>
                      <span class="readout text-xs text-ink-2">{lead.name}</span>
                    </figcaption>
                  </figure>
                ) : (
                  <ProductPlate product={lead} mode="card" />
                )}
              </div>
            </article>

            <!-- The rest of the line: two-up premium cards -->
            <div class="mt-14 grid gap-6 sm:grid-cols-2">
              {rest.map((product) => (
                <a
                  href={`/products/${product.line}/${product.slug}`}
                  class="catalogue-card group relative flex flex-col border border-hairline bg-raised transition-colors duration-300"
                  data-catalogue-item
                  data-regions={regionsOf(product.slug)}
                  data-reveal
                >
                  <span class="relative block overflow-hidden">
                    {product.views && product.views.length > 0 ? (
                      <span
                        class="relative block aspect-[4/3] specimen"
                        aria-hidden="true"
                      >
                        <img
                          src={product.views[0].small ?? product.views[0].src}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          class="card-img absolute inset-0 h-full w-full object-contain p-8"
                        />
                        {product.views.length > 1 && (
                          <img
                            src={product.views[1].small ?? product.views[1].src}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            class="card-img-alt absolute inset-0 h-full w-full object-contain p-8 opacity-0"
                          />
                        )}
                      </span>
                    ) : (
                      <ProductPlate product={product} mode="card" class="border-0" />
                    )}
                  </span>
                  <span class="flex flex-1 flex-col justify-between p-7">
                    <span>
                      <span class="readout block text-xs text-platinum">
                        {indexOf(product.slug)} — {product.category}
                      </span>
                      <span class="mt-3 block font-display text-3xl font-bold text-ink md:text-4xl">
                        {product.name}
                      </span>
                      <span class="mt-3 block text-body leading-relaxed text-ink-2">
                        {product.tagline}
                      </span>
                    </span>
                    <span class="readout mt-8 block text-xs text-ink-2 transition-colors duration-300 group-hover:text-ink">
                      View system →
                    </span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        </section>
      );
    })
  }

  <!-- The surgeon's route back in, now that For Surgeons has left the nav -->
  <section data-contrast class="relative overflow-hidden bg-base text-ink">
    <NeuralField variant="edge" seed={107} />
    <div class="relative mx-auto max-w-6xl px-6 py-16 md:py-28">
      <p class="eyebrow" data-reveal>Operating with Integrant</p>
      <h2 class="display-1 mt-6 max-w-3xl" data-reveal>
        Consult, specify, theatre, document.
      </h2>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-2" data-reveal>
        The surgeon's journey in four steps — direct engineering access, an
        anatomy-indexed catalogue, complete loan sets and AI-drafted notes.
      </p>
      <p class="mt-10" data-reveal>
        <a href="/for-surgeons" class="cta-ghost">For surgeons →</a>
      </p>
    </div>
  </section>

  <section class="relative bg-raised text-ink">
    <div class="mx-auto max-w-6xl border-t border-hairline px-6 py-16">
      <p class="max-w-3xl text-sm leading-relaxed text-ink-3">
        Implant systems are supplied to healthcare professionals on enquiry.
        Product specifications are provided for identification and are subject
        to confirmation; refer to the Instructions for Use supplied with each
        device for indications, contraindications and warnings.
      </p>
    </div>
  </section>
</Base>

<script>
  // Anatomy filter. Progressive enhancement: without JS, or with an unknown
  // region, the full catalogue shows. The region value is only ever compared
  // against the allowlist baked into the page — never written into the DOM.
  const bar = document.getElementById('region-filter');
  const region = new URLSearchParams(location.search).get('region') ?? '';
  const names: Record<string, string> = bar ? JSON.parse(bar.dataset.regionsMap ?? '{}') : {};
  if (bar && Object.hasOwn(names, region)) {
    const cards = [...document.querySelectorAll<HTMLElement>('[data-catalogue-item]')];
    let shown = 0;
    for (const card of cards) {
      const match = (card.dataset.regions ?? '').split(' ').includes(region);
      card.hidden = !match;
      if (match) shown += 1;
    }
    for (const section of document.querySelectorAll<HTMLElement>('[data-line-section]')) {
      section.hidden = !section.querySelector('[data-catalogue-item]:not([hidden])');
    }
    const label = bar.querySelector<HTMLElement>('[data-region-label]');
    if (label) label.textContent = `${names[region]} — ${shown} of ${cards.length} systems`;
    bar.hidden = false;
  }
</script>

<style>
  /* The filter hides cards with the hidden attribute; layout utilities such
     as grid/flex would otherwise override its display:none. */
  [data-catalogue-item][hidden],
  [data-line-section][hidden] {
    display: none;
  }

  @media (hover: hover) {
    .catalogue-card:hover {
      border-color: var(--color-hairline-strong);
      background-color: var(--color-inset);
    }
    .card-img,
    .card-img-alt {
      transition: opacity 500ms var(--ease-precise), transform 700ms var(--ease-precise);
    }
    .catalogue-card:hover .card-img {
      transform: scale(1.03);
    }
    /* Only fade the base image out when a hover replacement actually exists */
    .catalogue-card:hover .card-img:has(+ .card-img-alt) {
      opacity: 0;
    }
    .catalogue-card:hover .card-img-alt {
      opacity: 1;
      transform: scale(1.03);
    }
  }
</style>
