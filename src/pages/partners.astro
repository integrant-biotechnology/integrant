---
// /partners — "Topology". One idea executed hard: the four partnership
// models as named nodes on the lattice, each a bracket-framed plate that
// expands (native <details>, zero JS) into what Integrant looks for and
// what it provides. Rewritten from the intent of legacy /supplier; the
// legacy Partners@ address is unused until the client confirms the
// mailbox exists — every CTA routes through /contact.
import Base from '../layouts/Base.astro';
import SubpageHero from '../components/SubpageHero.astro';
import NeuralField from '../components/ui/NeuralField.astro';
import { PARTNER_MODELS } from '../data/pages/partners';
---

<Base
  footerCta={false}
  title="Partners — Distribution, hospitals and research — Integrant"
  ogImage="/og/partners.png"
  description="Distribution, hospital procurement, manufacturing and research partnerships with Integrant — Sydney-based orthopaedic med-tech and bio-tech."
>
  <SubpageHero
    title="Partners."
    kicker="Distribution · Hospitals · Suppliers · Research"
    lede="Integrant works through a small, deliberate network."
    crumbs={[{ label: 'Integrant', href: '/' }, { label: 'Partners' }]}
    docRef="Doc 06 — Partners"
    seed={173}
    variant="lattice"
  />

  <!-- The topology: four nodes on the lattice -->
  <section data-contrast class="relative overflow-hidden bg-base text-ink">
    <NeuralField variant="lattice" seed={179} pulse />
    <div class="relative mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="eyebrow" data-reveal>01 — The network</p>
      <h2 class="display-1 mt-6 max-w-2xl" data-reveal>Four ways in.</h2>

      <!-- The topology, drawn: four nodes streaming into the mark -->
      <svg viewBox="0 0 900 200" class="mt-12 hidden w-full md:block" fill="none" data-draw data-reveal aria-hidden="true">
        <path d="M 40 40 C 240 40, 330 100, 424 100" stroke="currentColor" stroke-width="1.2" class="text-ink-3"></path>
        <path d="M 40 160 C 240 160, 330 100, 424 100" stroke="currentColor" stroke-width="1.2" class="text-ink-3"></path>
        <path d="M 860 40 C 660 40, 570 100, 476 100" stroke="currentColor" stroke-width="1.2" class="text-ink-3"></path>
        <path d="M 860 160 C 660 160, 570 100, 476 100" stroke="currentColor" stroke-width="1.2" class="text-ink-3"></path>
        <circle cx="40" cy="40" r="4" fill="currentColor" class="text-ink-2"></circle>
        <circle cx="40" cy="160" r="4" fill="currentColor" class="text-ink-2"></circle>
        <circle cx="860" cy="40" r="4" fill="currentColor" class="text-ink-2"></circle>
        <circle cx="860" cy="160" r="4" fill="currentColor" class="text-ink-2"></circle>
        <circle cx="450" cy="100" r="26" stroke="currentColor" stroke-width="1.5" class="text-ink"></circle>
        <circle cx="450" cy="100" r="7" fill="currentColor" class="text-ink"></circle>
      </svg>

      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {
          PARTNER_MODELS.map((model, i) => (
            <article class="relative border border-hairline bg-base/60 backdrop-blur-[2px]" data-reveal data-partner-model>
              <h3 class="flex items-baseline gap-5 p-7">
                <span class="readout text-xs text-ink-2">{String(i + 1).padStart(2, '0')}</span>
                <span class="font-display text-2xl font-bold text-ink md:text-3xl">{model.label}</span>
              </h3>
              <div class="grid gap-8 border-t border-hairline p-7 sm:grid-cols-2">
                <div>
                  <p class="readout text-xs text-ink-2">We look for</p>
                  <p class="mt-4 text-body leading-relaxed text-ink-2">{model.seeks}</p>
                </div>
                <div>
                  <p class="readout text-xs text-ink-2">We provide</p>
                  <p class="mt-4 text-body leading-relaxed text-ink-2">{model.provides}</p>
                </div>
              </div>
              <span class="corner corner-tl border-hairline-strong" aria-hidden="true" />
              <span class="corner corner-br border-hairline-strong" aria-hidden="true" />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Close -->
  <section class="relative bg-raised text-ink">
    <NeuralField variant="edge" seed={181} />
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-28">
      <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <h2 class="display-1" data-reveal>
            Start the conversation.
          </h2>
          <p class="mt-6 max-w-xl text-lg text-ink-2" data-reveal>
            Tell us which of the four models fits. A member of the team — not
            a pipeline — reads every enquiry.
          </p>
        </div>
        <div data-reveal>
          <a href="/contact?channel=partners" class="cta-solid" data-magnetic data-event="Request Meeting" data-event-location="partners">Partner enquiry</a>
        </div>
      </div>
    </div>
  </section>
</Base>
