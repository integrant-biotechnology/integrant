---
// /innovation — the Wassup platform first, then the biomedical and device
// programmes. Only the hero and the R&D band (04) are permanent dark bands;
// everything between follows the theme — a page whose first viewport is all
// contrast bands makes the theme switch look broken (that bug shipped twice).
// Copy rules live in src/data/innovation.ts.
import Base from '../layouts/Base.astro';
import SubpageHero from '../components/SubpageHero.astro';
import NeuralField from '../components/ui/NeuralField.astro';
import {
  WASSUP_PLATFORM,
  WASSUP_GROUPS,
  WASSUP_PRODUCTS,
  WASSUP_STEPS,
  RD_PROGRAMMES,
} from '../data/innovation';

const inUse = WASSUP_PRODUCTS.filter((p) => p.status === 'In use').length;
const inDevelopment = WASSUP_PRODUCTS.length - inUse;
---

<Base
  title="Innovation — the Wassup platform — Integrant"
  ogImage="/og/innovation.png"
  description="Wassup, the Integrant clinical AI platform: six software agents for clinicians, practices and research, alongside the biomedical and medical device programmes."
>
  <SubpageHero
    title="Innovation."
    kicker="AI · Biomedical · Medical devices"
    lede="Wassup is the Integrant clinical AI platform: software agents that draft, organise and answer, with a qualified person reviewing every output."
    crumbs={[{ label: 'Integrant', href: '/' }, { label: 'Innovation' }]}
    docRef="Doc 03 — Innovation"
    meta={[
      { label: 'Platform', value: 'Wassup' },
      { label: 'In use', value: String(inUse) },
      { label: 'In development', value: String(inDevelopment) },
    ]}
    seed={223}
    variant="dense"
    pulse
    backdrop="/photo/theatre-lights.jpg"
  />

  <!-- 01 · The platform — theme-responsive, so the toggle visibly works -->
  <section class="relative overflow-hidden bg-base text-ink">
    <NeuralField variant="dense" seed={227} />
    <div class="relative mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="eyebrow" data-reveal>01 — The platform</p>
      <h2 class="display-1 mt-6 max-w-3xl" data-reveal>{WASSUP_PLATFORM.heading}</h2>
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink-2" data-reveal>{WASSUP_PLATFORM.body}</p>
    </div>
  </section>

  <!-- 02 · The products, in two groups -->
  <section class="relative bg-raised text-ink">
    <NeuralField variant="lattice" seed={229} />
    <div class="relative mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="eyebrow" data-reveal>02 — The products</p>
      <h2 class="display-1 mt-6 max-w-2xl" data-reveal>Six agents, one platform.</h2>

      {
        WASSUP_GROUPS.map((group) => (
          <div class="mt-14">
            <h3 class="readout text-xs text-ink-2" data-reveal>{group.label}</h3>
            <div class="mt-5 grid gap-px border border-hairline bg-hairline sm:grid-cols-2 lg:grid-cols-3">
              {WASSUP_PRODUCTS.filter((p) => p.group === group.id).map((product) => (
                <article class="relative flex min-h-64 min-w-0 flex-col bg-raised p-7" data-reveal>
                  <span class="corner corner-tr border-hairline-strong" aria-hidden="true" />
                  <p class={`readout text-xs ${product.status === 'In use' ? 'text-ink' : 'text-ink-2'}`}>
                    {product.status}
                  </p>
                  <h4 class="mt-4 font-display text-2xl font-semibold text-ink">{product.name}</h4>
                  <p class="mt-4 text-body leading-relaxed text-ink-2">{product.summary}</p>
                  {product.points && (
                    <ul class="mt-6 space-y-3 border-t border-hairline pt-5">
                      {product.points.map((point) => (
                        <li class="text-body leading-relaxed text-ink-2">{point}</li>
                      ))}
                    </ul>
                  )}
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 03 · How every agent works -->
  <section class="relative bg-base text-ink">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="eyebrow" data-reveal>03 — How Wassup works</p>
      <h2 class="display-1 mt-6 max-w-2xl" data-reveal>Drafted by the agent. Decided by a person.</h2>

      <ol class="mt-16 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
        {
          WASSUP_STEPS.map((step) => (
            <li class="relative min-w-0 border-t border-hairline pt-9" data-reveal>
              <span
                class="absolute -top-[3px] left-0 h-[5px] w-[5px] rounded-full bg-platinum"
                aria-hidden="true"
              />
              <svg
                viewBox="0 0 52 52"
                class="h-12 w-12 text-ink-2"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                data-draw
                aria-hidden="true"
              >
                {step.icon.map((d) => (
                  <path d={d} />
                ))}
              </svg>
              <p class="readout mt-6 text-xs text-platinum">
                {step.index} — {step.label}
              </p>
              <p class="mt-4 text-body leading-relaxed text-ink-2">{step.copy}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 04 · Biomedical and device R&D -->
  <section data-contrast class="relative bg-base text-ink">
    <NeuralField variant="dense" seed={233} />
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="eyebrow" data-reveal>04 — Biomedical &amp; medical devices</p>
      <h2 class="display-1 mt-6 max-w-2xl" data-reveal>Three programmes, one company.</h2>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-2" data-reveal>
        Engineering continues across implants, biologics and software, each programme led by
        the people who will use the result in theatre.
      </p>

      <div class="mt-12 grid gap-px border border-hairline bg-hairline sm:grid-cols-3">
        {
          RD_PROGRAMMES.map((programme) => (
            <div class="relative flex min-h-56 min-w-0 flex-col bg-base p-7" data-reveal>
              <span class="corner corner-tr border-hairline-strong" aria-hidden="true" />
              <h3 class="font-display text-2xl font-semibold text-ink">{programme.title}</h3>
              <p class="mt-4 text-body leading-relaxed text-ink-2">{programme.body}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-14 flex flex-wrap gap-4" data-reveal>
        <a href="/for-surgeons" class="cta-ghost">For surgeons →</a>
        <a href="/research" class="cta-ghost">Research activity →</a>
        <a href="/contact" class="cta-ghost" data-event="Request Meeting" data-event-location="innovation">Get in touch →</a>
      </div>
    </div>
  </section>
</Base>
