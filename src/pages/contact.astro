---
// /contact — "Transmission". The form is a technical console; the location
// is an engineering nameplate over a build-time dot-map of Australia.
// Form posts to /api/contact (Vercel function → Resend). Until the Resend
// key is provisioned (PUBLIC_CONTACT_FORM_ENABLED), the console renders
// with fields disabled and mailto as the primary CTA — one flag flip.
import Base from '../layouts/Base.astro';
import SubpageHero from '../components/SubpageHero.astro';
import NeuralField from '../components/ui/NeuralField.astro';
import { CONTACT } from '../data/pages/contact';
import { buildDotMap } from '../lib/dot-map';

const formEnabled = import.meta.env.PUBLIC_CONTACT_FORM_ENABLED === '1';
const map = buildDotMap();
---

<Base
  title="Contact — Integrant"
  ogImage="/og/contact.png"
  description="Contact Integrant — orthopaedic implant systems, biologics and AI clinical software. Sydney, Australia."
>
  <SubpageHero
    title="Contact."
    kicker="Sydney · Australia"
    lede="Product enquiries, distribution, clinical support — every message reaches the team that engineers the systems."
    crumbs={[{ label: 'Integrant', href: '/' }, { label: 'Contact' }]}
    docRef="Doc 07 — Contact"
    meta={[
      { label: 'Email', value: 'admin@integrant.com.au' },
      { label: 'Address', value: 'Potts Point NSW 2011' },
      { label: 'Position', value: '33.87°S · 151.22°E' },
    ]}
    seed={131}
    variant="edge"
    backdrop="/photo/sydney-night.jpg"
  />

  <section class="relative bg-raised text-ink">
    <NeuralField variant="organic" seed={137} />
    <div class="relative mx-auto grid max-w-6xl gap-16 px-6 py-16 md:grid-cols-[1fr_minmax(320px,420px)] md:py-28">
      <!-- The console -->
      <div>
        <p class="eyebrow" data-reveal>01 — Transmission</p>
        <h2 class="display-1 mt-6" data-reveal>Write to the team.</h2>

        <form
          id="enquiry"
          class="mt-10 max-w-xl space-y-9"
          method="POST"
          action="/api/contact"
          data-enabled={formEnabled ? 'true' : 'false'}
          data-reveal
        >
          <label class="console-field">
            <span class="readout block text-xs text-ink-2">Name</span>
            <input type="text" name="name" autocomplete="name" required disabled={!formEnabled} />
          </label>
          <label class="console-field">
            <span class="readout block text-xs text-ink-2">Email</span>
            <input type="email" name="email" autocomplete="email" required disabled={!formEnabled} />
          </label>
          <label class="console-field">
            <span class="readout block text-xs text-ink-2">Subject</span>
            <input type="text" name="subject" required disabled={!formEnabled} />
          </label>
          <label class="console-field">
            <span class="readout block text-xs text-ink-2">Message</span>
            <textarea name="message" rows="5" required disabled={!formEnabled}></textarea>
          </label>

          <!-- Spam controls carried from the legacy WPForms setup: honeypot +
               minimum fill time (stamped on load, checked server-side) -->
          <div class="hidden" aria-hidden="true">
            <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
            <input type="hidden" name="ts" value="" />
          </div>

          {
            formEnabled ? (
              <div class="flex flex-wrap items-center gap-6">
                <button type="submit" class="cta-solid" data-magnetic>
                  Transmit
                </button>
                <p class="readout text-xs text-ink-2">Response within 2 business days</p>
              </div>
            ) : (
              <div class="border border-hairline bg-base p-6">
                <p class="readout text-xs text-ink-2">CONSOLE PROVISIONING</p>
                <p class="mt-3 text-ink-2">
                  Direct transmission is being connected. Until then, email reaches the same desk:
                </p>
                <a href={`mailto:${CONTACT.email}`} class="cta-solid mt-6 inline-flex" data-event="Email Click" data-event-location="contact-console">
                  {CONTACT.email}
                </a>
              </div>
            )
          }

          <p id="form-status" class="readout hidden text-xs text-ink" role="status" aria-live="polite"></p>
        </form>
      </div>

      <!-- The location plate -->
      <aside class="md:pt-14">
        <div class="border border-hairline bg-base p-8" data-reveal>
          <p class="readout text-xs text-ink-2">02 — Location</p>

          <svg
            viewBox={`0 0 ${map.width} ${map.height}`}
            class="mt-6 w-full text-ink"
            aria-hidden="true"
          >
            {map.dots.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill="currentColor" opacity="0.22" />)}
            <circle class="map-marker-ring" cx={map.sydney.x} cy={map.sydney.y} r="14" fill="none" stroke="currentColor" stroke-width="1.5" />
            <circle cx={map.sydney.x} cy={map.sydney.y} r="4" fill="currentColor" />
            <text
              x={map.sydney.x - 14}
              y={map.sydney.y + 4}
              text-anchor="end"
              fill="currentColor"
              style="font-family: var(--font-display); font-size: 17px; letter-spacing: 0.2em;"
            >SYDNEY</text>
          </svg>

          <div class="mt-8 border-t border-hairline pt-6">
            <p class="font-display text-lg font-semibold text-ink">{CONTACT.address.line1}</p>
            <p class="text-ink-2">{CONTACT.address.line2} · {CONTACT.address.country}</p>
            <p class="readout mt-4 text-xs text-ink-3">{CONTACT.address.coordinates}</p>
          </div>
        </div>

        <!-- Channels -->
        <ul class="mt-6 divide-y divide-[var(--color-hairline)] border border-hairline bg-base" data-reveal>
          {
            CONTACT.channels.map((channel) => (
              <li>
                <a
                  href={channel.href}
                  class="group flex items-center justify-between gap-4 p-5 transition-colors duration-300"
                  data-event={channel.href.startsWith('mailto:') ? 'Email Click' : undefined}
                  data-event-location={channel.href.startsWith('mailto:') ? 'contact-channels' : undefined}
                >
                  <span class="readout text-xs text-ink-2 transition-colors duration-300 group-hover:text-ink">
                    {channel.label}
                  </span>
                  <span class="font-display text-sm font-semibold text-ink-2 transition-colors duration-300 group-hover:text-ink">
                    {channel.value} →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="readout mt-6 text-xs leading-relaxed text-ink-2" data-reveal>
          NO SWITCHBOARD · WRITTEN CHANNELS ONLY — EVERY ENQUIRY IS READ BY THE TEAM
        </p>
      </aside>
    </div>
  </section>
</Base>

<script>
  import { track } from '../scripts/analytics';

  // Progressive enhancement only: stamp the fill-time field, prefill the
  // subject from ?channel=, intercept submit for an inline success readout.
  // With JS disabled the form still posts and the function 303s back here.
  const form = document.getElementById('enquiry') as HTMLFormElement | null;
  // Allowlisted channel — the only query value that ever reaches analytics.
  const CHANNELS = ['partners', 'surgeons', 'research', 'clinical'];
  const rawChannel = new URLSearchParams(location.search).get('channel') ?? '';
  const safeChannel = CHANNELS.includes(rawChannel) ? rawChannel : 'direct';
  if (form && form.dataset.enabled === 'true') {
    const ts = form.querySelector<HTMLInputElement>('input[name="ts"]');
    if (ts) ts.value = String(Date.now());

    // Allowlist only — never reflect arbitrary query text into the field.
    const CHANNEL_SUBJECTS: Record<string, string> = {
      partners: 'Partnership enquiry',
      surgeons: 'Surgeon enquiry',
      research: 'Research collaboration enquiry',
      clinical: 'Clinical case material request',
    };
    const channel = new URLSearchParams(location.search).get('channel') ?? '';
    const subject = form.querySelector<HTMLInputElement>('input[name="subject"]');
    if (subject && !subject.value && CHANNEL_SUBJECTS[channel]) {
      subject.value = CHANNEL_SUBJECTS[channel];
    }

    const status = document.getElementById('form-status');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status) return form.submit();
      status.classList.remove('hidden');
      status.textContent = 'TRANSMITTING —';
      try {
        // urlencoded, not FormData: Vercel functions don't parse multipart
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString(),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.querySelectorAll('input, textarea, button').forEach((el) => ((el as HTMLInputElement).disabled = true));
        status.textContent = 'RECEIVED — RESPONSE WITHIN 2 BUSINESS DAYS';
        // After the UI has settled: a tracking failure can never touch the form.
        track('Contact Submit', { channel: safeChannel });
      } catch {
        status.textContent = 'TRANSMISSION FAILED — EMAIL admin@integrant.com.au DIRECTLY';
      }
    });
  }

  // Non-JS round trip lands back here with ?sent=1
  if (new URLSearchParams(location.search).get('sent') === '1') {
    const status = document.getElementById('form-status');
    if (status) {
      status.classList.remove('hidden');
      status.textContent = 'RECEIVED — RESPONSE WITHIN 2 BUSINESS DAYS';
    }
    track('Contact Submit', { channel: safeChannel });
  }
</script>
