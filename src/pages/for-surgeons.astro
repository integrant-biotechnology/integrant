---
// /for-surgeons — "The Tray". The surgeon's journey as information
// architecture: 01 CONSULT → 02 SPECIFY (anatomy index) → 03 THEATRE
// (line-drawn instruments — deliberate: stronger than renders, and the
// portfolio's photography gap never blocks this page) → 04 DOCUMENT.
// Public page addressed to HCPs: activity language only, no outcomes.
// The pricing plate exists but renders nothing until FOR_SURGEONS
// .showPricing flips (cms page.ts contract). Absorbs the legacy
// /pricing URL at cutover; the legacy page body contributed nothing
// (Elementor demo content).
import Base from '../layouts/Base.astro';
import SubpageHero from '../components/SubpageHero.astro';
import NeuralField from '../components/ui/NeuralField.astro';
import OpNote from '../components/ui/OpNote.astro';
import PhotoPlate from '../components/ui/PhotoPlate.astro';
import ProductPlate from '../components/ui/ProductPlate.astro';
import { FOR_SURGEONS } from '../data/pages/for-surgeons';
import { ANATOMY_AREAS } from '../data/anatomy-areas';
import { getProduct } from '../data/products';
import { PRODUCT_DRAWINGS } from '../data/product-drawings';

const [consult, specify, theatre, doc] = FOR_SURGEONS.steps;

// One source of truth for the drawing language: these three seeded the full
// per-product set in src/data/product-drawings.ts and now import from it.
const instruments = [
  { label: 'Screw systems', caption: 'ScrewIT · 2.5–6.5 mm', drawing: PRODUCT_DRAWINGS['screwit']! },
  { label: 'Anchors', caption: 'AnchorIT · small + large', drawing: PRODUCT_DRAWINGS['anchorit']! },
  { label: 'Fusion', caption: 'FuseIT · arthrodesis plug', drawing: PRODUCT_DRAWINGS['fuseit']! },
];
---

<Base
  title="For surgeons — Working with Integrant"
  ogImage="/og/for-surgeons.png"
  description="How surgeons work with Integrant — consultation, anatomy-indexed specification, complete tray systems and Wassup Doc, in development, for operation notes."
>
  <SubpageHero
    title="For surgeons."
    kicker="Consult · Specify · Theatre · Document"
    lede="Four steps between your first enquiry and a signed operation note — each one handled by the team that engineers the systems."
    crumbs={[{ label: 'Integrant', href: '/' }, { label: 'For surgeons' }]}
    docRef="Doc 02 — For Surgeons"
    chips={['Loan sets', 'Direct engineering access', 'AU · NZ']}
    seed={191}
    variant="dense"
    backdrop="/photo/theatre.jpg"
  />

  <!-- 01 · Consult -->
  <section class="relative bg-raised text-ink">
    <NeuralField variant="edge" seed={193} />
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="font-display text-8xl font-bold text-ink-3" aria-hidden="true">{consult.index}</p>
      <div class="mt-4 grid gap-10 md:grid-cols-2">
        <div>
          <p class="eyebrow" data-reveal><span class="sr-only">{consult.index} — </span>{consult.label}</p>
          <h2 class="display-1 mt-6" data-reveal>{consult.heading}</h2>
        </div>
        <div class="md:pt-14">
          <p class="max-w-xl text-lg leading-relaxed text-ink-2" data-reveal>{consult.body}</p>
          <div class="mt-8" data-reveal>
            <a href="/contact?channel=surgeons" class="cta-ghost" data-event="Request Meeting" data-event-location="for-surgeons">Arrange a consult</a>
          </div>
          <div class="mt-12" data-reveal>
            <PhotoPlate
              src="/photo/tray.jpg"
              alt="A sterile surgical instrument tray"
              width={1200}
              height={800}
              caption="Theatre-ready · sterile field"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · Specify — the anatomy index -->
  <section class="relative bg-base text-ink">
    <NeuralField variant="organic" seed={197} />
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="font-display text-8xl font-bold text-ink-3" aria-hidden="true">{specify.index}</p>
      <p class="mt-4 eyebrow" data-reveal><span class="sr-only">{specify.index} — </span>{specify.label}</p>
      <h2 class="display-1 mt-6 max-w-2xl" data-reveal>{specify.heading}</h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-2" data-reveal>{specify.body}</p>

      {/* Only regions with a system in the catalogue are listed: the two
          broadest lead the row, the rest sit beneath. */}
      <div class="mt-14 grid gap-px border border-hairline bg-hairline sm:grid-cols-2 lg:grid-cols-6">
        {
          ANATOMY_AREAS.map((area, i, all) => {
            const spanLast = i === all.length - 1 && all.length % 2 === 1;
            const products = area.productSlugs.map((slug) => getProduct(slug)).filter(Boolean);
            const active = products.length > 0;
            return active ? (
              <a href={`/products?region=${area.slug}`} class:list={['group relative flex min-h-64 flex-col justify-between bg-raised p-7 transition-colors duration-300 hover:bg-base', spanLast && 'sm:col-span-2', i < 2 ? 'lg:col-span-3' : 'lg:col-span-2']} data-reveal>
                <div>
                  {/* first-party anatomy plate art (legacy capture, regraded) —
                      image and text never overlap (rendered-contrast contract) */}
                  {area.illustration ? (
                    <img
                      src={area.illustration}
                      alt=""
                      width="900"
                      height="900"
                      loading="lazy"
                      class="mb-6 h-36 w-full object-contain opacity-75 transition-opacity duration-300 group-hover:opacity-100"
                      aria-hidden="true"
                    />
                  ) : (
                    /* No anatomy illustration (external fixators is a device
                       class, not a region): its lead system's drawing holds the
                       same slot so every card lines up */
                    <div class="mb-6 flex h-36 items-center justify-center opacity-75 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true">
                      <ProductPlate product={products[0]!} mode="thumb" class="h-32 w-32 border-0 bg-transparent" />
                    </div>
                  )}
                  <h3 class="font-display text-2xl font-semibold text-ink">{area.name}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-ink-2">{area.summary}</p>
                </div>
                <div class="mt-8">
                  {/* The systems themselves, not a bare count */}
                  <p class="readout text-xs leading-relaxed text-ink-2">
                    {products.map((p) => p!.name).join(' · ')}
                  </p>
                  <p class="readout mt-3 text-xs leading-relaxed text-ink-2 transition-colors duration-300 group-hover:text-ink">
                    View catalogue →
                  </p>
                </div>
              </a>
            ) : null;
          })
        }
      </div>
    </div>
  </section>

  <!-- 03 · Theatre — the tray, drawn -->
  <section class="relative bg-raised text-ink">
    <NeuralField variant="edge" seed={199} />
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-32">
      <p class="font-display text-8xl font-bold text-ink-3" aria-hidden="true">{theatre.index}</p>
      <div class="mt-4 grid gap-10 md:grid-cols-2">
        <div>
          <p class="eyebrow" data-reveal><span class="sr-only">{theatre.index} — </span>{theatre.label}</p>
          <h2 class="display-1 mt-6" data-reveal>{theatre.heading}</h2>
        </div>
        <p class="max-w-xl text-lg leading-relaxed text-ink-2 md:pt-14" data-reveal>{theatre.body}</p>
      </div>

      <!-- Technical line drawings, drawn in on scroll. Deliberately schematic:
           these are engineering sketches of the system families, not renders
           of specific devices. -->
      <div class="mt-16 grid gap-px border border-hairline bg-hairline sm:grid-cols-3">
        {
          instruments.map((inst) => (
            <figure class="bg-raised p-8" data-reveal>
              <svg viewBox={inst.drawing.viewBox} class="mx-auto h-56 text-ink" fill="none" data-draw aria-hidden="true">
                {inst.drawing.dashed && (
                  <path d={inst.drawing.dashed} stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 7" class="text-ink-3" data-no-draw />
                )}
                {inst.drawing.paths.map((d) => (
                  <path d={d} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                ))}
              </svg>
              <figcaption class="mt-6 border-t border-hairline pt-4">
                <p class="font-display text-lg font-semibold text-ink">{inst.label}</p>
                <p class="readout mt-2 text-xs text-ink-2">{inst.caption}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-between gap-6" data-reveal>
        <p class="readout text-xs text-ink-2">{FOR_SURGEONS.ifuNote} · SPECIFICATIONS IN THE CATALOGUE</p>
        <a href="/products" class="cta-ghost">Full catalogue →</a>
      </div>
    </div>
  </section>

  <!-- 04 · Document — the app, in the dark band -->
  <section data-contrast class="relative overflow-hidden bg-base text-ink">
    <NeuralField variant="dense" seed={211} pulse />
    <div class="mx-auto grid max-w-6xl gap-16 px-6 py-20 md:grid-cols-[1fr_280px] md:py-32">
      <div>
        <p class="font-display text-8xl font-bold text-ink-3" aria-hidden="true">{doc.index}</p>
        <p class="mt-4 eyebrow" data-reveal><span class="sr-only">{doc.index} — </span>{doc.label}</p>
        <h2 class="display-1 mt-6" data-reveal>{doc.heading}</h2>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-2" data-reveal>{doc.body}</p>
        <div class="mt-10" data-reveal>
          <a href="/innovation" class="cta-ghost">The Wassup ecosystem →</a>
        </div>
      </div>
      <div class="relative mx-auto mt-4 w-full max-w-[17rem] md:mt-16 md:w-64" data-reveal aria-hidden="true">
        <OpNote />
      </div>
    </div>
  </section>

  {
    FOR_SURGEONS.showPricing && FOR_SURGEONS.pricing.rows.length > 0 && (
      <section class="relative bg-raised text-ink">
        <div class="mx-auto max-w-6xl px-6 py-16 md:py-28">
          <p class="eyebrow" data-reveal>
            {FOR_SURGEONS.pricing.heading}
          </p>
          <div class="mt-8 border border-hairline bg-base">
            {FOR_SURGEONS.pricing.rows.map((row) => (
              <div class="grid grid-cols-[1fr_auto] gap-6 border-b border-hairline p-6 last:border-0">
                <p class="text-ink-2">{row.item}</p>
                <p class="font-display font-semibold text-ink">{row.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
