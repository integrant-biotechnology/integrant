# Build-time flags (Astro exposes PUBLIC_* to the client bundle).
# Set these on Vercel for the Production environment only — leave them
# unset locally so `npm run qa` builds carry no live wiring.

# Enables the contact form fields (also needs RESEND_API_KEY on the function).
PUBLIC_CONTACT_FORM_ENABLED=

# Plausible site domain. When set, Base.astro renders the analytics tag,
# served first-party through the /stats/* rewrites in vercel.json.
# Use the final domain from day one so history survives the DNS cutover.
PUBLIC_PLAUSIBLE_DOMAIN=

# Serverless function env (api/contact.ts) — never PUBLIC_.
RESEND_API_KEY=
CONTACT_INBOX=admin@integrant.com.au
CONTACT_FROM=
