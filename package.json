{
  "name": "integrant-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "og": "node --experimental-strip-types scripts/generate-og.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:rendered": "node scripts/audit-rendered-contrast.mjs",
    "qa:sweep": "node scripts/qa-sweep.mjs",
    "validate:redirects": "node scripts/validate-redirects.mjs",
    "qa": "npm run build && npm run audit:contrast && npm run validate:redirects && npm run audit:rendered && npm run audit:type",
    "scrape": "node scripts/scrape-legacy.mjs",
    "scrape:diff": "node scripts/scrape-legacy.mjs --diff",
    "audit:type": "node scripts/audit-type-floor.mjs",
    "qa:analytics": "node scripts/audit-analytics.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/titillium-web": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "ogl": "^1.0.11",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}
